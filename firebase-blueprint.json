{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private authenticated player account record isolated to the owning user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the account owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified account email address.",
          "maxLength": 320
        },
        "displayName": {
          "type": "string",
          "description": "Account display name.",
          "minLength": 1,
          "maxLength": 100
        },
        "gameUid": {
          "type": "string",
          "description": "Unique numeric Game UID for friend lookup (0000 reserved exclusively for GM ffsmilepay53@gmail.com).",
          "minLength": 4,
          "maxLength": 8,
          "pattern": "^[0-9]{4,8}$"
        },
        "role": {
          "type": "string",
          "description": "Account role ('gm' for sole developer account, 'player' otherwise).",
          "enum": ["gm", "player"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the account profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the account profile was last updated."
        }
      },
      "required": ["uid", "email", "displayName", "gameUid", "role", "createdAt", "updatedAt"]
    },
    "CharacterSave": {
      "title": "CharacterSave",
      "description": "Playable RPG character slot and full cloud save state owned by a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Character slot document ID.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the character owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "In-game character name.",
          "minLength": 1,
          "maxLength": 24
        },
        "jobId": {
          "type": "string",
          "description": "Current RPG class/job identifier.",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "level": {
          "type": "integer",
          "description": "Current character level."
        },
        "exp": {
          "type": "integer",
          "description": "Current character experience points."
        },
        "hp": {
          "type": "integer",
          "description": "Current character health points."
        },
        "mp": {
          "type": "integer",
          "description": "Current character mana points."
        },
        "gold": {
          "type": "integer",
          "description": "Current gold currency."
        },
        "diamonds": {
          "type": "integer",
          "description": "Current diamond currency."
        },
        "mapId": {
          "type": "string",
          "description": "Current map identifier.",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "playTime": {
          "type": "number",
          "description": "Total play time in seconds."
        },
        "saveData": {
          "type": "object",
          "description": "Native Firestore map containing full SaveData state."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the character was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the character was last saved."
        }
      },
      "required": [
        "id",
        "ownerId",
        "name",
        "jobId",
        "level",
        "exp",
        "hp",
        "mp",
        "gold",
        "diamonds",
        "mapId",
        "playTime",
        "saveData",
        "createdAt",
        "updatedAt"
      ]
    },
    "DailyMissionBoard": {
      "title": "DailyMissionBoard",
      "description": "Randomly assigned daily missions and completion progress stored per date for a player.",
      "type": "object",
      "properties": {
        "dateKey": {
          "type": "string",
          "description": "Local calendar date key (YYYY-MM-DD).",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the player who owns this daily mission board.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "missions": {
          "type": "array",
          "description": "Fixed list of 3 randomly rolled daily mission objects with progress and claimed flags."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the daily missions were generated."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when progress or claim state was last updated."
        }
      },
      "required": ["dateKey", "ownerId", "missions", "createdAt", "updatedAt"]
    },
    "PlayerUidDirectory": {
      "title": "PlayerUidDirectory",
      "description": "Non-PII public lookup entry mapping a short numeric Game UID to a player account for friend adding.",
      "type": "object",
      "properties": {
        "gameUid": {
          "type": "string",
          "description": "Unique numeric Game UID (0000 reserved solely for ffsmilepay53@gmail.com).",
          "minLength": 4,
          "maxLength": 8,
          "pattern": "^[0-9]{4,8}$"
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the player who owns this Game UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Public player display name (no email/PII).",
          "minLength": 1,
          "maxLength": 100
        },
        "characterName": {
          "type": "string",
          "description": "Latest active character name.",
          "minLength": 1,
          "maxLength": 24
        },
        "level": {
          "type": "integer",
          "description": "Latest active character level."
        },
        "jobId": {
          "type": "string",
          "description": "Latest active character job identifier.",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "isGm": {
          "type": "boolean",
          "description": "True exclusively for UID 0000 (ffsmilepay53@gmail.com)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the Game UID was registered."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the directory summary was updated."
        }
      },
      "required": [
        "gameUid",
        "ownerId",
        "displayName",
        "characterName",
        "level",
        "jobId",
        "isGm",
        "createdAt",
        "updatedAt"
      ]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Bilateral friend request and accepted friendship record between two players identified by Game UID.",
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "description": "Deterministic document ID formatted as {fromUid}__{toUid}.",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fromUid": {
          "type": "string",
          "description": "Sender Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "toUid": {
          "type": "string",
          "description": "Recipient Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fromGameUid": {
          "type": "string",
          "description": "Sender Game UID.",
          "minLength": 4,
          "maxLength": 8,
          "pattern": "^[0-9]{4,8}$"
        },
        "toGameUid": {
          "type": "string",
          "description": "Recipient Game UID.",
          "minLength": 4,
          "maxLength": 8,
          "pattern": "^[0-9]{4,8}$"
        },
        "fromName": {
          "type": "string",
          "description": "Sender public display name.",
          "minLength": 1,
          "maxLength": 100
        },
        "toName": {
          "type": "string",
          "description": "Recipient public display name.",
          "minLength": 1,
          "maxLength": 100
        },
        "fromIsGm": {
          "type": "boolean",
          "description": "Whether sender is the sole GM account."
        },
        "toIsGm": {
          "type": "boolean",
          "description": "Whether recipient is the sole GM account."
        },
        "status": {
          "type": "string",
          "description": "Friendship status.",
          "enum": ["pending", "accepted", "declined"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when request was sent."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when status was last updated."
        }
      },
      "required": [
        "requestId",
        "fromUid",
        "toUid",
        "fromGameUid",
        "toGameUid",
        "fromName",
        "toName",
        "fromIsGm",
        "toIsGm",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorldPresence": {
      "title": "WorldPresence",
      "description": "Non-PII real-time map position and avatar state of an active online player.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the online player.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "gameUid": {
          "type": "string",
          "description": "Unique numeric Game UID displayed next to player name.",
          "minLength": 4,
          "maxLength": 8,
          "pattern": "^[0-9]{4,8}$"
        },
        "uid": {
          "type": "integer",
          "description": "Numeric player UID (0 reserved exclusively for GM)."
        },
        "displayName": {
          "type": "string",
          "description": "Active character name shown overhead.",
          "minLength": 1,
          "maxLength": 24
        },
        "jobId": {
          "type": "string",
          "description": "Active character job class identifier.",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mapId": {
          "type": "string",
          "description": "Current RPG map identifier.",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "x": {
          "type": "number",
          "description": "World X coordinate in pixels."
        },
        "y": {
          "type": "number",
          "description": "World Y coordinate in pixels."
        },
        "level": {
          "type": "integer",
          "description": "Current character level."
        },
        "gm": {
          "type": "boolean",
          "description": "Whether the player holds verified GM privileges."
        },
        "facing": {
          "type": "string",
          "description": "Sprite facing direction.",
          "enum": ["up", "down", "left", "right"]
        },
        "moving": {
          "type": "boolean",
          "description": "Whether the character is currently walking."
        },
        "status": {
          "type": "string",
          "description": "Live activity status displayed in world presence list.",
          "enum": ["town", "idle", "moving", "combat"]
        },
        "attackAnim": {
          "type": "number",
          "description": "Remaining attack swing timer in seconds."
        },
        "invisible": {
          "type": "boolean",
          "description": "Must be false for public presence entries."
        },
        "heartbeatMs": {
          "type": "integer",
          "description": "Client epoch millisecond heartbeat counter."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Firestore server timestamp (request.time) for staleness detection."
        }
      },
      "required": [
        "userId",
        "gameUid",
        "uid",
        "displayName",
        "jobId",
        "mapId",
        "x",
        "y",
        "level",
        "gm",
        "facing",
        "moving",
        "status",
        "attackAnim",
        "invisible",
        "heartbeatMs",
        "updatedAt"
      ]
    },
    "Party": {
      "title": "Party",
      "description": "Cooperative multiplayer RPG party (up to 4 players) with live member stats and leader control.",
      "type": "object",
      "properties": {
        "partyId": {
          "type": "string",
          "description": "Unique party document ID.",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Display name of the party.",
          "minLength": 1,
          "maxLength": 32
        },
        "leaderId": {
          "type": "string",
          "description": "Firebase Auth UID of the party leader.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "memberIds": {
          "type": "array",
          "description": "Bounded list (1 to 4) of member Firebase Auth UIDs."
        },
        "members": {
          "type": "object",
          "description": "Map keyed by member Firebase Auth UID storing live RPG character snapshot (zero PII)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the party was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when party state or member snapshot was last updated."
        }
      },
      "required": [
        "partyId",
        "name",
        "leaderId",
        "memberIds",
        "members",
        "createdAt",
        "updatedAt"
      ]
    },
    "PartyInvite": {
      "title": "PartyInvite",
      "description": "Invitation sent by a party leader to another verified player identified by Game UID.",
      "type": "object",
      "properties": {
        "inviteId": {
          "type": "string",
          "description": "Deterministic ID formatted as {partyId}__{toUid}.",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "partyId": {
          "type": "string",
          "description": "Target party ID.",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "partyName": {
          "type": "string",
          "description": "Target party display name.",
          "minLength": 1,
          "maxLength": 32
        },
        "fromUid": {
          "type": "string",
          "description": "Inviter (party leader) Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "toUid": {
          "type": "string",
          "description": "Invited player Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fromGameUid": {
          "type": "string",
          "description": "Inviter Game UID.",
          "minLength": 4,
          "maxLength": 8,
          "pattern": "^[0-9]{4,8}$"
        },
        "toGameUid": {
          "type": "string",
          "description": "Invited player Game UID.",
          "minLength": 4,
          "maxLength": 8,
          "pattern": "^[0-9]{4,8}$"
        },
        "fromName": {
          "type": "string",
          "description": "Inviter character name.",
          "minLength": 1,
          "maxLength": 24
        },
        "toName": {
          "type": "string",
          "description": "Invited player character name.",
          "minLength": 1,
          "maxLength": 24
        },
        "fromIsGm": {
          "type": "boolean",
          "description": "Whether the inviter is the sole verified GM."
        },
        "status": {
          "type": "string",
          "description": "Invitation status.",
          "enum": ["pending", "accepted", "declined"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when invitation was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when invitation status was updated."
        }
      },
      "required": [
        "inviteId",
        "partyId",
        "partyName",
        "fromUid",
        "toUid",
        "fromGameUid",
        "toGameUid",
        "fromName",
        "toName",
        "fromIsGm",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Guild": {
      "title": "Guild",
      "description": "Public player-created guild with member roster, donation level, and passive buffs.",
      "type": "object",
      "properties": {
        "guildId": { "type": "string", "minLength": 3, "maxLength": 48, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 28 },
        "tag": { "type": "string", "minLength": 2, "maxLength": 6 },
        "leaderId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "leaderName": { "type": "string", "minLength": 1, "maxLength": 24 },
        "level": { "type": "integer", "minimum": 1, "maximum": 50 },
        "exp": { "type": "integer", "minimum": 0 },
        "totalDonatedGold": { "type": "integer", "minimum": 0 },
        "memberIds": { "type": "array", "maxItems": 30, "items": { "type": "string" } },
        "memberCount": { "type": "integer", "minimum": 1, "maximum": 30 },
        "notice": { "type": "string", "maxLength": 140 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["guildId", "name", "tag", "leaderId", "leaderName", "level", "exp", "totalDonatedGold", "memberIds", "memberCount", "notice", "createdAt", "updatedAt"]
    },
    "LeaderboardHero": {
      "title": "LeaderboardHero",
      "description": "Public non-PII character snapshot for Hall of Fame and Async PvP Arena.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "gameUid": { "type": "string", "minLength": 4, "maxLength": 8, "pattern": "^[0-9]{4,8}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 24 },
        "jobId": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "level": { "type": "integer", "minimum": 1, "maximum": 999 },
        "rebirthCount": { "type": "integer", "minimum": 0, "maximum": 6 },
        "combatPower": { "type": "integer", "minimum": 1 },
        "arenaRating": { "type": "integer", "minimum": 100, "maximum": 9999 },
        "arenaWins": { "type": "integer", "minimum": 0 },
        "highestTowerFloor": { "type": "integer", "minimum": 0 },
        "activeTitle": { "type": "string", "maxLength": 64 },
        "guildName": { "type": "string", "maxLength": 32 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "gameUid", "name", "jobId", "level", "rebirthCount", "combatPower", "arenaRating", "arenaWins", "highestTowerFloor", "updatedAt"]
    },
    "WorldBossRaid": {
      "title": "WorldBossRaid",
      "description": "Shared timed World Boss instance keyed by hourly rotation cycleKey.",
      "type": "object",
      "properties": {
        "cycleKey": { "type": "string", "minLength": 4, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bossId": { "type": "string", "minLength": 2, "maxLength": 48, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "maxHp": { "type": "integer", "minimum": 1000 },
        "currentHp": { "type": "integer", "minimum": 0 },
        "totalDamageDealt": { "type": "integer", "minimum": 0 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["cycleKey", "bossId", "name", "maxHp", "currentHp", "totalDamageDealt", "updatedAt"]
    },
    "WorldBossContribution": {
      "title": "WorldBossContribution",
      "description": "Player damage contribution record for a timed World Boss cycle.",
