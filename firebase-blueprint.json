      "properties": {
        "messageId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 24 },
        "senderGameUid": { "type": "string", "minLength": 4, "maxLength": 8, "pattern": "^[0-9]{4,8}$" },
        "jobId": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 180 },
        "createdAtMs": { "type": "integer", "minimum": 0 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["messageId", "senderUid", "senderName", "senderGameUid", "jobId", "text", "createdAtMs", "createdAt"]
    },
    "GuildRaid": {
      "title": "GuildRaid",
      "description": "Shared cooperative Guild Raid Boss instance owned by a guild.",
      "type": "object",
      "properties": {
        "raidId": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "guildId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bossName": { "type": "string", "minLength": 1, "maxLength": 64 },
        "level": { "type": "integer", "minimum": 1, "maximum": 999 },
        "maxHp": { "type": "integer", "minimum": 1000 },
        "currentHp": { "type": "integer", "minimum": 0 },
        "clears": { "type": "integer", "minimum": 0 },
        "lastHitter": { "type": "string", "maxLength": 24 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["raidId", "guildId", "bossName", "level", "maxHp", "currentHp", "clears", "lastHitter", "updatedAt"]
    },
    "MarketListing": {
      "title": "MarketListing",
      "description": "Public auction house item listing posted by verified players.",
