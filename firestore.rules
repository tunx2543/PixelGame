          isEmailVerified() &&
          userId == request.auth.uid &&
          existing().ownerId == request.auth.uid;

        allow create: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(userId) &&
          isValidId(characterId) &&
          userId == request.auth.uid &&
          isValidCharacterSave(incoming(), characterId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isUserAccountOwner(userId);

        allow update: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(userId) &&
          isValidId(characterId) &&
          userId == request.auth.uid &&
          isValidCharacterSave(incoming(), characterId) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'jobId',
            'level',
            'exp',
            'hp',
            'mp',
            'gold',
            'diamonds',
            'mapId',
            'playTime',
            'saveData',
            'updatedAt'
          ]) &&
          isUserAccountOwner(userId);

        allow delete: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(userId) &&
          isValidId(characterId) &&
          userId == request.auth.uid &&
          isUserAccountOwner(userId) &&
          existing().ownerId == request.auth.uid;

        match /diamondTransactions/{txId} {
          allow get: if isSignedIn() &&
            isEmailVerified() &&
            isValidId(userId) &&
            isValidId(characterId) &&
            isValidId(txId) &&
            userId == request.auth.uid &&
            isUserAccountOwner(userId) &&
            (resource == null || existing().ownerId == request.auth.uid);

          allow list: if isSignedIn() &&
            isEmailVerified() &&
            isValidId(userId) &&
            isValidId(characterId) &&
            userId == request.auth.uid &&
            existing().ownerId == request.auth.uid &&
            request.query.limit != null &&
            request.query.limit <= 100;

          allow create: if isSignedIn() &&
            isEmailVerified() &&
            isValidId(userId) &&
            isValidId(characterId) &&
            isValidId(txId) &&
            userId == request.auth.uid &&
            isValidDiamondTransaction(incoming(), txId, characterId) &&
            incoming().createdAt == request.time &&
            isUserAccountOwner(userId);

          allow update, delete: if false;
        }

        match /auditLogs/{logId} {
          allow get: if isSignedIn() &&
            isEmailVerified() &&
            isValidId(userId) &&
            isValidId(characterId) &&
            isValidId(logId) &&
            userId == request.auth.uid &&
            isUserAccountOwner(userId) &&
            (resource == null || existing().ownerId == request.auth.uid);

          allow list: if isSignedIn() &&
            isEmailVerified() &&
            isValidId(userId) &&
            isValidId(characterId) &&
            userId == request.auth.uid &&
            existing().ownerId == request.auth.uid &&
            request.query.limit != null &&
            request.query.limit <= 100;

          allow create: if isSignedIn() &&
            isEmailVerified() &&
            isValidId(userId) &&
            isValidId(characterId) &&
            isValidId(logId) &&
            userId == request.auth.uid &&
            isValidPremiumAuditLog(incoming(), logId, characterId) &&
            incoming().createdAt == request.time &&
            isUserAccountOwner(userId);

          allow update, delete: if false;
        }

        match /topupOrders/{orderId} {
          allow get: if isSignedIn() &&
            isEmailVerified() &&
            isValidId(userId) &&
            isValidId(characterId) &&
            isValidId(orderId) &&
