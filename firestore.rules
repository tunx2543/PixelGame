rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidGameUid(gameUid) {
      return gameUid is string && gameUid.size() >= 4 && gameUid.size() <= 8 && gameUid.matches('^[0-9]{4,8}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isGmAccount() {
      return isSignedIn() &&
        isEmailVerified() &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == 'ffsmilepay53@gmail.com';
    }

    function isTopupAdminAccount() {
      return isSignedIn() &&
        isEmailVerified() &&
        request.auth.token.email is string &&
        (
          request.auth.token.email.lower() == 'ffsmilepay53@gmail.com' ||
          request.auth.token.email.lower() == 'berlinxsirith7@gmail.com'
        );
    }

    function isUserAccountOwner(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'gameUid', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'gameUid', 'role', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == request.auth.uid &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 320 &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 100 &&
        isValidGameUid(data.gameUid) &&
        data.role in ['gm', 'player'] &&
        (
          (isGmAccount() && data.gameUid == '0000' && data.role == 'gm') ||
          (!isGmAccount() && data.gameUid != '0000' && data.role == 'player')
        ) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPlayerUidEntry(data, gameUid) {
      return data.keys().hasAll([
          'gameUid',
          'ownerId',
          'displayName',
          'characterName',
          'level',
          'jobId',
          'isGm',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'gameUid',
          'ownerId',
          'displayName',
          'characterName',
          'level',
          'jobId',
          'isGm',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidGameUid(data.gameUid) &&
        data.gameUid == gameUid &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 100 &&
        data.characterName is string &&
        data.characterName.size() >= 1 &&
        data.characterName.size() <= 24 &&
        data.level is int &&
        data.level >= 1 &&
        data.level <= 999 &&
        data.jobId is string &&
        data.jobId.size() >= 1 &&
        data.jobId.size() <= 32 &&
        data.jobId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.isGm is bool &&
        (
          (gameUid == '0000' && isGmAccount() && data.isGm == true) ||
          (gameUid != '0000' && data.isGm == false)
        ) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFriendRequest(data, requestId) {
      return data.keys().hasAll([
          'requestId',
          'fromUid',
          'toUid',
          'fromGameUid',
          'toGameUid',
          'fromName',
          'toName',
          'fromIsGm',
          'toIsGm',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'requestId',
          'fromUid',
          'toUid',
          'fromGameUid',
          'toGameUid',
          'fromName',
          'toName',
          'fromIsGm',
          'toIsGm',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.requestId) &&
        data.requestId == requestId &&
        isValidId(data.fromUid) &&
        isValidId(data.toUid) &&
        data.fromUid != data.toUid &&
        data.requestId == data.fromUid + '__' + data.toUid &&
        isValidGameUid(data.fromGameUid) &&
        isValidGameUid(data.toGameUid) &&
        data.fromGameUid != data.toGameUid &&
        data.fromName is string &&
        data.fromName.size() >= 1 &&
        data.fromName.size() <= 100 &&
        data.toName is string &&
        data.toName.size() >= 1 &&
        data.toName.size() <= 100 &&
        data.fromIsGm is bool &&
        data.toIsGm is bool &&
        data.status in ['pending', 'accepted', 'declined'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCharacterSave(data, characterId) {
      return data.keys().hasAll([
          'id',
          'ownerId',
          'name',
          'jobId',
          'level',
          'exp',
          'hp',
          'mp',
          'gold',
          'diamonds',
          'mapId',
          'playTime',
          'saveData',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'ownerId',
          'name',
          'jobId',
          'level',
          'exp',
          'hp',
          'mp',
          'gold',
          'diamonds',
          'mapId',
          'playTime',
          'saveData',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == characterId &&
        data.id.size() <= 64 &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 24 &&
        data.jobId is string &&
        data.jobId.size() >= 1 &&
        data.jobId.size() <= 32 &&
        data.jobId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.level is int &&
        data.level >= 1 &&
        data.level <= 999 &&
        data.exp is int &&
        data.exp >= 0 &&
        data.hp is int &&
        data.hp >= 0 &&
        data.mp is int &&
        data.mp >= 0 &&
        data.gold is int &&
        data.gold >= 0 &&
        data.diamonds is int &&
        data.diamonds >= 0 &&
        data.mapId is string &&
        data.mapId.size() >= 1 &&
        data.mapId.size() <= 32 &&
        data.mapId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.playTime is number &&
        data.playTime >= 0 &&
        data.saveData is map &&
        data.saveData.keys().size() <= 60 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDiamondTransaction(data, txId, characterId) {
      return data.keys().hasAll([
          'txId',
          'requestId',
          'ownerId',
          'characterId',
          'type',
          'source',
          'amount',
          'balanceBefore',
          'balanceAfter',
          'productId',
          'itemId',
          'note',
          'actorUid',
          'isGm',
          'serverVerified',
          'serverSignature',
          'createdAtMs',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'txId',
          'requestId',
          'ownerId',
          'characterId',
          'type',
          'source',
          'amount',
          'balanceBefore',
          'balanceAfter',
          'productId',
          'itemId',
          'note',
          'actorUid',
          'isGm',
          'serverVerified',
          'serverSignature',
          'createdAtMs',
          'createdAt'
        ]) &&
        isValidId(data.txId) &&
        data.txId == txId &&
        data.txId.size() <= 64 &&
        isValidId(data.requestId) &&
        data.requestId.size() <= 64 &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.characterId) &&
        data.characterId == characterId &&
        data.characterId.size() <= 64 &&
        data.type in ['earn', 'spend', 'sandbox_grant', 'refund'] &&
        data.source is string &&
        data.source.size() >= 1 &&
        data.source.size() <= 48 &&
        data.amount is int &&
        data.amount >= 0 &&
        data.amount <= 1000000000 &&
        data.balanceBefore is int &&
        data.balanceBefore >= 0 &&
        data.balanceBefore <= 1000000000 &&
        data.balanceAfter is int &&
        data.balanceAfter >= 0 &&
        data.balanceAfter <= 1000000000 &&
        (data.productId == null || (data.productId is string && data.productId.size() <= 64)) &&
        (data.itemId == null || (data.itemId is string && data.itemId.size() <= 64)) &&
        data.note is string &&
        data.note.size() >= 1 &&
        data.note.size() <= 180 &&
        isValidId(data.actorUid) &&
        data.actorUid == request.auth.uid &&
        data.isGm is bool &&
        (
          (!data.isGm && data.source != 'gm_grant') ||
          isGmAccount()
        ) &&
        data.serverVerified is bool &&
        (data.serverSignature == null || (data.serverSignature is string && data.serverSignature.size() <= 64)) &&
        data.createdAtMs is int &&
        data.createdAtMs >= 0 &&
        data.createdAt is timestamp;
    }

    function isValidPremiumAuditLog(data, logId, characterId) {
      return data.keys().hasAll([
          'logId',
          'ownerId',
          'characterId',
          'action',
          'actorUid',
          'actorRole',
          'txId',
          'details',
          'verifiedByServer',
          'createdAtMs',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'logId',
          'ownerId',
          'characterId',
          'action',
          'actorUid',
          'actorRole',
          'txId',
          'details',
          'verifiedByServer',
          'createdAtMs',
          'createdAt'
        ]) &&
        isValidId(data.logId) &&
        data.logId == logId &&
        data.logId.size() <= 64 &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.characterId) &&
        data.characterId == characterId &&
        data.characterId.size() <= 64 &&
        data.action in [
          'SANDBOX_GRANT',
          'DIAMOND_EARN',
          'DIAMOND_SPEND',
          'PREMIUM_PURCHASE',
          'VIP_ACTIVATE',
          'VIP_CLAIM_TIER',
          'VIP_CLAIM_DAILY',
          'PASS_UNLOCK',
          'PASS_CLAIM',
          'PASS_ARCHIVE_CLAIM',
          'STORAGE_EXPAND',
          'FASHION_EQUIP'
        ] &&
        isValidId(data.actorUid) &&
        data.actorUid == request.auth.uid &&
        data.actorRole in ['gm', 'player'] &&
        (data.actorRole == 'player' || isGmAccount()) &&
        (data.txId == null || (isValidId(data.txId) && data.txId.size() <= 64)) &&
        data.details is string &&
        data.details.size() >= 1 &&
        data.details.size() <= 240 &&
        data.verifiedByServer is bool &&
        data.createdAtMs is int &&
        data.createdAtMs >= 0 &&
        data.createdAt is timestamp;
    }

    function isValidMissionEntry(m) {
      return m is map &&
        m.keys().hasAll([
          'id',
          'type',
          'title',
          'description',
          'target',
          'progress',
          'claimed',
          'rewardGold',
          'rewardDiamonds',
          'rewardExp',
          'rewardStones'
        ]) &&
        m.keys().hasOnly([
          'id',
          'type',
          'title',
          'description',
          'target',
          'progress',
          'claimed',
          'rewardGold',
          'rewardDiamonds',
          'rewardExp',
          'rewardStones'
        ]) &&
        isValidId(m.id) &&
        m.id.size() <= 64 &&
        m.type in ['kills', 'bossKills', 'skillsUsed', 'enhances', 'towerClears', 'goldEarned', 'itemsLooted'] &&
        m.title is string &&
        m.title.size() >= 1 &&
        m.title.size() <= 80 &&
        m.description is string &&
        m.description.size() >= 1 &&
        m.description.size() <= 200 &&
        m.target is int &&
        m.target >= 1 &&
        m.target <= 100000 &&
        m.progress is int &&
        m.progress >= 0 &&
        m.progress <= 100000 &&
        m.claimed is bool &&
        m.rewardGold is int &&
        m.rewardGold >= 0 &&
        m.rewardGold <= 100000 &&
        m.rewardDiamonds is int &&
        m.rewardDiamonds >= 0 &&
        m.rewardDiamonds <= 10000 &&
        m.rewardExp is int &&
        m.rewardExp >= 0 &&
        m.rewardExp <= 100000 &&
        m.rewardStones is int &&
        m.rewardStones >= 0 &&
        m.rewardStones <= 1000;
    }

    function isValidMissionTransition(prev, next) {
      return prev.id == next.id &&
        prev.type == next.type &&
        prev.target == next.target &&
        prev.rewardGold == next.rewardGold &&
        prev.rewardDiamonds == next.rewardDiamonds &&
        prev.rewardExp == next.rewardExp &&
        prev.rewardStones == next.rewardStones &&
        next.progress >= prev.progress &&
        (!prev.claimed || next.claimed) &&
        (!next.claimed || next.progress >= next.target);
    }

    function isValidTopupOrder(data, orderId, characterId) {
      return data.keys().hasAll([
          'orderId',
          'ownerId',
          'characterId',
          'packageId',
          'packageName',
          'provider',
          'gatewayRef',
          'amountThb',
          'baseDiamonds',
          'bonusDiamonds',
          'totalDiamonds',
          'vipExpGranted',
          'status',
          'txId',
          'serverVerified',
          'serverSignature',
          'createdAtMs',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'orderId',
          'ownerId',
          'characterId',
          'packageId',
          'packageName',
          'provider',
          'gatewayRef',
          'amountThb',
          'baseDiamonds',
          'bonusDiamonds',
          'totalDiamonds',
          'vipExpGranted',
          'status',
          'txId',
          'serverVerified',
          'serverSignature',
          'createdAtMs',
          'createdAt'
        ]) &&
        isValidId(data.orderId) &&
        data.orderId == orderId &&
        data.orderId.size() <= 64 &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.characterId) &&
        data.characterId == characterId &&
        data.characterId.size() <= 64 &&
        isValidId(data.packageId) &&
        data.packageId.size() >= 2 &&
        data.packageId.size() <= 64 &&
        data.packageName is string &&
        data.packageName.size() >= 1 &&
        data.packageName.size() <= 120 &&
        data.provider in ['stripe_promptpay', 'stripe_checkout', 'promptpay_slip', 'promptpay_manual_gm'] &&
        data.gatewayRef is string &&
        data.gatewayRef.size() >= 4 &&
        data.gatewayRef.size() <= 128 &&
        data.amountThb is int &&
        data.amountThb >= 1 &&
        data.amountThb <= 100000 &&
        data.baseDiamonds is int &&
        data.baseDiamonds >= 1 &&
        data.baseDiamonds <= 1000000 &&
        data.bonusDiamonds is int &&
        data.bonusDiamonds >= 0 &&
        data.bonusDiamonds <= 1000000 &&
        data.totalDiamonds is int &&
        data.totalDiamonds >= 1 &&
        data.totalDiamonds <= 2000000 &&
        data.totalDiamonds == data.baseDiamonds + data.bonusDiamonds &&
        data.vipExpGranted is int &&
        data.vipExpGranted >= 0 &&
        data.vipExpGranted <= 100000 &&
        data.status == 'credited' &&
        isValidId(data.txId) &&
        data.txId.size() >= 4 &&
        data.txId.size() <= 64 &&
        data.serverVerified is bool &&
        (data.serverSignature == null || (data.serverSignature is string && data.serverSignature.size() <= 64)) &&
        data.createdAtMs is int &&
        data.createdAtMs >= 0 &&
        data.createdAt is timestamp &&
        (
          (
            data.provider in ['stripe_promptpay', 'stripe_checkout', 'promptpay_slip'] &&
            data.serverVerified == true &&
            data.serverSignature is string &&
            data.serverSignature.size() >= 16
          ) ||
          (
            data.provider == 'promptpay_manual_gm' &&
            isValidId(data.gatewayRef) &&
            exists(/databases/$(database)/documents/topupSlipRequests/$(data.gatewayRef)) &&
            get(/databases/$(database)/documents/topupSlipRequests/$(data.gatewayRef)).data.status == 'approved' &&
            get(/databases/$(database)/documents/topupSlipRequests/$(data.gatewayRef)).data.ownerId == request.auth.uid &&
            get(/databases/$(database)/documents/topupSlipRequests/$(data.gatewayRef)).data.packageId == data.packageId &&
            get(/databases/$(database)/documents/topupSlipRequests/$(data.gatewayRef)).data.totalDiamonds == data.totalDiamonds
          )
        );
    }

    function isValidPromptPayShopSettings(data, settingId) {
      return data.keys().hasAll([
          'settingId',
          'promptPayId',
          'accountName',
          'customQrDataUrl',
          'enabled',
          'updatedByUid',
          'createdAtMs',
          'updatedAtMs',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'settingId',
          'promptPayId',
          'accountName',
          'customQrDataUrl',
          'enabled',
          'updatedByUid',
          'createdAtMs',
          'updatedAtMs',
          'createdAt',
          'updatedAt'
        ]) &&
        data.settingId == settingId &&
        data.settingId == 'promptpay' &&
        data.promptPayId is string &&
        data.promptPayId.size() <= 32 &&
        data.accountName is string &&
        data.accountName.size() >= 1 &&
        data.accountName.size() <= 80 &&
        (data.customQrDataUrl == null || (data.customQrDataUrl is string && data.customQrDataUrl.size() >= 20 && data.customQrDataUrl.size() <= 350000)) &&
        data.enabled is bool &&
        isValidId(data.updatedByUid) &&
        data.createdAtMs is int &&
        data.createdAtMs >= 0 &&
        data.updatedAtMs is int &&
        data.updatedAtMs >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTopupSlipRequest(data, requestId) {
      return data.keys().hasAll([
          'requestId',
          'ownerId',
          'ownerEmail',
          'playerName',
          'gameUid',
          'characterId',
          'packageId',
          'packageName',
          'amountThb',
          'baseDiamonds',
          'bonusDiamonds',
          'totalDiamonds',
          'vipExpGranted',
          'slipDataUrl',
          'slipNote',
          'status',
          'claimed',
          'claimedAtMs',
          'reviewedByUid',
          'reviewNote',
          'createdAtMs',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'requestId',
          'ownerId',
          'ownerEmail',
          'playerName',
          'gameUid',
          'characterId',
          'packageId',
          'packageName',
          'amountThb',
          'baseDiamonds',
          'bonusDiamonds',
          'totalDiamonds',
          'vipExpGranted',
          'slipDataUrl',
          'slipNote',
          'status',
          'claimed',
          'claimedAtMs',
          'reviewedByUid',
          'reviewNote',
          'createdAtMs',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.requestId) &&
        data.requestId == requestId &&
        data.requestId.size() <= 64 &&
        isValidId(data.ownerId) &&
        data.ownerEmail is string &&
        data.ownerEmail.size() >= 3 &&
        data.ownerEmail.size() <= 320 &&
        data.playerName is string &&
        data.playerName.size() >= 1 &&
        data.playerName.size() <= 40 &&
        isValidGameUid(data.gameUid) &&
        isValidId(data.characterId) &&
        data.characterId.size() <= 64 &&
        isValidId(data.packageId) &&
        data.packageId.size() >= 2 &&
        data.packageId.size() <= 64 &&
        data.packageName is string &&
        data.packageName.size() >= 1 &&
        data.packageName.size() <= 120 &&
        data.amountThb is int &&
        data.amountThb >= 1 &&
        data.amountThb <= 100000 &&
        data.baseDiamonds is int &&
        data.baseDiamonds >= 1 &&
        data.baseDiamonds <= 1000000 &&
        data.bonusDiamonds is int &&
        data.bonusDiamonds >= 0 &&
        data.bonusDiamonds <= 1000000 &&
        data.totalDiamonds is int &&
        data.totalDiamonds >= 1 &&
        data.totalDiamonds <= 2000000 &&
        data.totalDiamonds == data.baseDiamonds + data.bonusDiamonds &&
        data.vipExpGranted is int &&
        data.vipExpGranted >= 0 &&
        data.vipExpGranted <= 100000 &&
        data.slipDataUrl is string &&
        data.slipDataUrl.size() >= 20 &&
        data.slipDataUrl.size() <= 350000 &&
        data.slipNote is string &&
        data.slipNote.size() <= 180 &&
        data.status in ['pending', 'approved', 'rejected'] &&
        data.claimed is bool &&
        (data.claimedAtMs == null || (data.claimedAtMs is int && data.claimedAtMs >= 0)) &&
        (data.reviewedByUid == null || isValidId(data.reviewedByUid)) &&
        (data.reviewNote == null || (data.reviewNote is string && data.reviewNote.size() <= 180)) &&
        data.createdAtMs is int &&
        data.createdAtMs >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDailyMissionBoard(data, dateKey) {
      return data.keys().hasAll(['dateKey', 'ownerId', 'missions', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['dateKey', 'ownerId', 'missions', 'createdAt', 'updatedAt']) &&
        data.dateKey is string &&
        data.dateKey == dateKey &&
        data.dateKey.size() == 10 &&
        data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.ownerId is string &&
        data.ownerId == request.auth.uid &&
        data.missions is list &&
        data.missions.size() == 3 &&
        isValidMissionEntry(data.missions[0]) &&
        isValidMissionEntry(data.missions[1]) &&
        isValidMissionEntry(data.missions[2]) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWorldPresence(data, userId) {
      return data.keys().hasAll([
          'userId',
          'gameUid',
          'uid',
          'displayName',
          'jobId',
          'mapId',
          'x',
          'y',
          'level',
          'gm',
          'facing',
          'moving',
          'status',
          'attackAnim',
          'invisible',
          'heartbeatMs',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'gameUid',
          'uid',
          'displayName',
          'jobId',
          'mapId',
          'x',
          'y',
          'level',
          'gm',
          'facing',
          'moving',
          'status',
          'attackAnim',
          'invisible',
          'heartbeatMs',
          'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userId == userId &&
        data.userId == request.auth.uid &&
        isValidGameUid(data.gameUid) &&
        data.uid is int &&
        data.uid >= 0 &&
        data.uid <= 99999999 &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 24 &&
        data.jobId is string &&
        data.jobId.size() >= 1 &&
        data.jobId.size() <= 32 &&
        data.jobId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.mapId is string &&
        data.mapId.size() >= 1 &&
        data.mapId.size() <= 32 &&
        data.mapId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.x is number &&
        data.x >= 0 &&
        data.x <= 5000 &&
        data.y is number &&
        data.y >= 0 &&
        data.y <= 5000 &&
        data.level is int &&
