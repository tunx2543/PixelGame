          'opponentGameUid',
          'turnNumber',
          'activeTurnUid',
          'fighters',
          'logs',
          'winnerUid',
          'createdAtMs',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.duelId) &&
        data.duelId == duelId &&
        data.status in ['pending', 'active', 'completed', 'declined', 'cancelled'] &&
        isValidId(data.challengerUid) &&
        isValidId(data.opponentUid) &&
        data.challengerUid != data.opponentUid &&
        data.challengerName is string &&
        data.challengerName.size() >= 1 &&
        data.challengerName.size() <= 24 &&
        data.opponentName is string &&
        data.opponentName.size() >= 1 &&
        data.opponentName.size() <= 24 &&
        isValidGameUid(data.challengerGameUid) &&
        isValidGameUid(data.opponentGameUid) &&
        data.turnNumber is int &&
        data.turnNumber >= 1 &&
        data.turnNumber <= 999 &&
        isValidId(data.activeTurnUid) &&
        data.fighters is map &&
        data.fighters.keys().size() == 2 &&
        data.logs is list &&
        data.logs.size() <= 30 &&
        (data.winnerUid == null || isValidId(data.winnerUid)) &&
        data.createdAtMs is int &&
        data.createdAtMs >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPlayerReport(data, reportId) {
      return data.keys().hasAll([
          'reportId',
          'reporterUid',
          'targetUid',
          'targetGameUid',
          'targetName',
          'reason',
          'details',
          'createdAtMs',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'reportId',
          'reporterUid',
          'targetUid',
          'targetGameUid',
          'targetName',
          'reason',
          'details',
          'createdAtMs',
          'createdAt'
        ]) &&
        isValidId(data.reportId) &&
        data.reportId == reportId &&
        isValidId(data.reporterUid) &&
        isValidId(data.targetUid) &&
        data.reporterUid != data.targetUid &&
        isValidGameUid(data.targetGameUid) &&
        data.targetName is string &&
        data.targetName.size() >= 1 &&
        data.targetName.size() <= 24 &&
        data.reason is string &&
        data.reason.size() >= 1 &&
        data.reason.size() <= 80 &&
        data.details is string &&
        data.details.size() <= 240 &&
        data.createdAtMs is int &&
        data.createdAtMs >= 0 &&
        data.createdAt is timestamp;
    }

    function isValidMailMessage(data, mailId) {
      return data.keys().hasAll([
          'mailId',
          'senderUid',
          'senderName',
          'senderGameUid',
          'subject',
          'body',
          'gold',
          'diamonds',
          'itemId',
          'qty',
          'plus',
          'claimed',
          'createdAtMs',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'mailId',
          'senderUid',
          'senderName',
          'senderGameUid',
          'subject',
          'body',
          'gold',
          'diamonds',
          'itemId',
          'qty',
          'plus',
          'claimed',
          'createdAtMs',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.mailId) &&
        data.mailId == mailId &&
        isValidId(data.senderUid) &&
        data.senderName is string &&
        data.senderName.size() >= 1 &&
        data.senderName.size() <= 24 &&
        isValidGameUid(data.senderGameUid) &&
        data.subject is string &&
        data.subject.size() >= 1 &&
        data.subject.size() <= 64 &&
        data.body is string &&
        data.body.size() >= 1 &&
        data.body.size() <= 240 &&
        data.gold is int &&
        data.gold >= 0 &&
        data.gold <= 10000000 &&
        data.diamonds is int &&
        data.diamonds >= 0 &&
        data.diamonds <= 100000 &&
        (data.itemId == null || isValidId(data.itemId)) &&
        data.qty is int &&
        data.qty >= 0 &&
        data.qty <= 999 &&
        data.plus is int &&
        data.plus >= 0 &&
        data.plus <= 20 &&
        data.claimed is bool &&
        data.createdAtMs is int &&
        data.createdAtMs >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPartyCoop(data, partyId, coopId) {
      return data.keys().hasAll(['coopId', 'partyId', 'dungeonName', 'bossName', 'level', 'maxHp', 'currentHp', 'clears', 'participants', 'lastHitter', 'updatedAt']) &&
        data.keys().hasOnly(['coopId', 'partyId', 'dungeonName', 'bossName', 'level', 'maxHp', 'currentHp', 'clears', 'participants', 'lastHitter', 'updatedAt']) &&
        isValidId(data.coopId) &&
        data.coopId == coopId &&
        isValidId(data.partyId) &&
        data.partyId == partyId &&
        data.dungeonName is string &&
        data.dungeonName.size() >= 1 &&
        data.dungeonName.size() <= 64 &&
        data.bossName is string &&
        data.bossName.size() >= 1 &&
        data.bossName.size() <= 64 &&
        data.level is int &&
        data.level >= 1 &&
        data.level <= 999 &&
        data.maxHp is int &&
        data.maxHp >= 1000 &&
        data.currentHp is int &&
        data.currentHp >= 0 &&
        data.currentHp <= data.maxHp &&
        data.clears is int &&
        data.clears >= 0 &&
        data.participants is list &&
        data.participants.size() <= 8 &&
        data.lastHitter is string &&
        data.lastHitter.size() <= 24 &&
        data.updatedAt is timestamp;
    }

    match /playerUids/{gameUid} {
      allow get: if isSignedIn() && isEmailVerified() && isValidGameUid(gameUid);
      allow list: if false;
      allow create: if isSignedIn() &&
        isEmailVerified() &&
        isValidGameUid(gameUid) &&
        isValidPlayerUidEntry(incoming(), gameUid) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isUserAccountOwner(request.auth.uid);
      allow update: if isSignedIn() &&
        isEmailVerified() &&
        isValidGameUid(gameUid) &&
        isValidPlayerUidEntry(incoming(), gameUid) &&
        existing().ownerId == request.auth.uid &&
        incoming().gameUid == existing().gameUid &&
        incoming().ownerId == existing().ownerId &&
        incoming().isGm == existing().isGm &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'characterName', 'level', 'jobId', 'updatedAt']) &&
        isUserAccountOwner(request.auth.uid);
      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      allow get: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(requestId) &&
        (resource == null || existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);
      allow list: if isSignedIn() &&
        isEmailVerified() &&
        (existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);
      allow create: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(requestId) &&
        isValidFriendRequest(incoming(), requestId) &&
        incoming().fromUid == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().fromIsGm == (incoming().fromGameUid == '0000' && isGmAccount()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/playerUids/$(incoming().fromGameUid)) &&
        get(/databases/$(database)/documents/playerUids/$(incoming().fromGameUid)).data.ownerId == request.auth.uid &&
        exists(/databases/$(database)/documents/playerUids/$(incoming().toGameUid)) &&
        get(/databases/$(database)/documents/playerUids/$(incoming().toGameUid)).data.ownerId == incoming().toUid &&
        get(/databases/$(database)/documents/playerUids/$(incoming().toGameUid)).data.isGm == incoming().toIsGm;
      allow update: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(requestId) &&
        isValidFriendRequest(incoming(), requestId) &&
        existing().toUid == request.auth.uid &&
        existing().status == 'pending' &&
        (incoming().status == 'accepted' || incoming().status == 'declined') &&
        incoming().requestId == existing().requestId &&
        incoming().fromUid == existing().fromUid &&
        incoming().toUid == existing().toUid &&
        incoming().fromGameUid == existing().fromGameUid &&
        incoming().toGameUid == existing().toGameUid &&
        incoming().fromName == existing().fromName &&
        incoming().toName == existing().toName &&
        incoming().fromIsGm == existing().fromIsGm &&
        incoming().toIsGm == existing().toIsGm &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(requestId) &&
        (existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);
    }

    match /worldPresence/{userId} {
      allow get: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(userId) &&
        (resource == null || existing().userId == request.auth.uid || existing().invisible == false);

      allow list: if isSignedIn() &&
        isEmailVerified() &&
        (resource.data.heartbeatMs >= 0 || resource.data.mapId is string) &&
        request.query.limit != null &&
        request.query.limit <= 60;

      allow create: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isUserAccountOwner(userId) &&
        isValidWorldPresence(incoming(), userId) &&
        incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isUserAccountOwner(userId) &&
        isValidWorldPresence(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'gameUid',
          'uid',
          'displayName',
          'jobId',
          'mapId',
          'x',
          'y',
          'level',
          'gm',
          'facing',
          'moving',
          'status',
          'attackAnim',
          'invisible',
          'heartbeatMs',
          'updatedAt'
        ]);

      allow delete: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(userId) &&
        userId == request.auth.uid;
    }

    match /parties/{partyId} {
      allow get: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(partyId) &&
        (resource == null || request.auth.uid in existing().memberIds);

      allow list: if isSignedIn() &&
        isEmailVerified() &&
        request.auth.uid in resource.data.memberIds &&
        request.query.limit != null &&
        request.query.limit <= 10;

      allow create: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(partyId) &&
        isValidPartyDoc(incoming(), partyId) &&
        incoming().leaderId == request.auth.uid &&
        incoming().memberIds.size() == 1 &&
        incoming().memberIds[0] == request.auth.uid &&
        isValidPartyMemberInfo(incoming().members[request.auth.uid], request.auth.uid) &&
        (incoming().members[request.auth.uid].isGm == false || isGmAccount()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isUserAccountOwner(request.auth.uid);

      allow update: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(partyId) &&
        isValidPartyDoc(incoming(), partyId) &&
        incoming().partyId == existing().partyId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Member updates own live RPG snapshot (hp/level/mapId/jobId/name)
          (
            request.auth.uid in existing().memberIds &&
            incoming().name == existing().name &&
            incoming().leaderId == existing().leaderId &&
            incoming().memberIds == existing().memberIds &&
            incoming().diff(existing()).affectedKeys().hasOnly(['members', 'updatedAt']) &&
            incoming().members.diff(existing().members).affectedKeys().hasOnly([request.auth.uid]) &&
            isValidPartyMemberInfo(incoming().members[request.auth.uid], request.auth.uid) &&
            (incoming().members[request.auth.uid].isGm == false || isGmAccount())
          ) ||
          // Action 2: Invited player joins party OR player joins via open Party Finder listing
          (
            !(request.auth.uid in existing().memberIds) &&
            existing().memberIds.size() < 4 &&
            incoming().name == existing().name &&
            incoming().leaderId == existing().leaderId &&
            incoming().memberIds.size() == existing().memberIds.size() + 1 &&
            incoming().memberIds.hasAll(existing().memberIds) &&
            request.auth.uid in incoming().memberIds &&
            incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'members', 'updatedAt']) &&
            incoming().members.diff(existing().members).affectedKeys().hasOnly([request.auth.uid]) &&
            isValidPartyMemberInfo(incoming().members[request.auth.uid], request.auth.uid) &&
            (incoming().members[request.auth.uid].isGm == false || isGmAccount()) &&
            (
              (
                exists(/databases/$(database)/documents/partyInvites/$(partyId + '__' + request.auth.uid)) &&
                get(/databases/$(database)/documents/partyInvites/$(partyId + '__' + request.auth.uid)).data.status == 'pending' &&
                get(/databases/$(database)/documents/partyInvites/$(partyId + '__' + request.auth.uid)).data.toUid == request.auth.uid &&
                get(/databases/$(database)/documents/partyInvites/$(partyId + '__' + request.auth.uid)).data.partyId == partyId
              ) ||
              (
                exists(/databases/$(database)/documents/partyListings/$(partyId)) &&
                get(/databases/$(database)/documents/partyListings/$(partyId)).data.status == 'open'
              )
            )
          ) ||
          // Action 3: Member voluntarily leaves party (transfers leader if leader leaves with members remaining)
          (
            request.auth.uid in existing().memberIds &&
            !(request.auth.uid in incoming().memberIds) &&
            incoming().name == existing().name &&
            incoming().memberIds.size() == existing().memberIds.size() - 1 &&
            incoming().memberIds.size() >= 1 &&
            existing().memberIds.hasAll(incoming().memberIds) &&
            (existing().leaderId == request.auth.uid || incoming().leaderId == existing().leaderId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['leaderId', 'memberIds', 'members', 'updatedAt']) &&
            incoming().members.diff(existing().members).affectedKeys().hasOnly([request.auth.uid])
          ) ||
          // Action 4: Leader renames party, transfers leadership, or kicks another member
          (
            existing().leaderId == request.auth.uid &&
            request.auth.uid in incoming().memberIds &&
            existing().memberIds.hasAll(incoming().memberIds) &&
            incoming().memberIds.size() >= 1 &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'leaderId', 'memberIds', 'members', 'updatedAt']) &&
            existing().members.keys().hasAll(incoming().members.keys())
          )
        );

      allow delete: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(partyId) &&
        (
          existing().leaderId == request.auth.uid ||
          (existing().memberIds.size() == 1 && request.auth.uid in existing().memberIds)
        );

      match /coops/{coopId} {
        allow get: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(partyId) &&
          isValidId(coopId) &&
          exists(/databases/$(database)/documents/parties/$(partyId)) &&
          request.auth.uid in get(/databases/$(database)/documents/parties/$(partyId)).data.memberIds;

        allow list: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(partyId) &&
          exists(/databases/$(database)/documents/parties/$(partyId)) &&
          request.auth.uid in get(/databases/$(database)/documents/parties/$(partyId)).data.memberIds &&
          request.query.limit != null &&
          request.query.limit <= 5;

        allow create: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(partyId) &&
          isValidId(coopId) &&
          exists(/databases/$(database)/documents/parties/$(partyId)) &&
          request.auth.uid in get(/databases/$(database)/documents/parties/$(partyId)).data.memberIds &&
          isValidPartyCoop(incoming(), partyId, coopId) &&
          incoming().updatedAt == request.time;

        allow update: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(partyId) &&
          isValidId(coopId) &&
          exists(/databases/$(database)/documents/parties/$(partyId)) &&
          request.auth.uid in get(/databases/$(database)/documents/parties/$(partyId)).data.memberIds &&
          isValidPartyCoop(incoming(), partyId, coopId) &&
          incoming().coopId == existing().coopId &&
          incoming().partyId == existing().partyId &&
          incoming().clears >= existing().clears &&
          incoming().updatedAt == request.time;

        allow delete: if false;
      }
    }

    match /partyInvites/{inviteId} {
      allow get: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(inviteId) &&
        (resource == null || existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);

      allow list: if isSignedIn() &&
        isEmailVerified() &&
        (existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid) &&
        request.query.limit != null &&
        request.query.limit <= 30;

      allow create: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(inviteId) &&
        isValidPartyInvite(incoming(), inviteId) &&
        incoming().fromUid == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().fromIsGm == (incoming().fromGameUid == '0000' && isGmAccount()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/parties/$(incoming().partyId)) &&
        get(/databases/$(database)/documents/parties/$(incoming().partyId)).data.leaderId == request.auth.uid &&
        get(/databases/$(database)/documents/parties/$(incoming().partyId)).data.memberIds.size() < 4 &&
        !(incoming().toUid in get(/databases/$(database)/documents/parties/$(incoming().partyId)).data.memberIds) &&
        exists(/databases/$(database)/documents/playerUids/$(incoming().fromGameUid)) &&
        get(/databases/$(database)/documents/playerUids/$(incoming().fromGameUid)).data.ownerId == request.auth.uid &&
        exists(/databases/$(database)/documents/playerUids/$(incoming().toGameUid)) &&
        get(/databases/$(database)/documents/playerUids/$(incoming().toGameUid)).data.ownerId == incoming().toUid;

      allow update: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(inviteId) &&
        isValidPartyInvite(incoming(), inviteId) &&
        existing().toUid == request.auth.uid &&
        existing().status == 'pending' &&
        (incoming().status == 'accepted' || incoming().status == 'declined') &&
        incoming().inviteId == existing().inviteId &&
        incoming().partyId == existing().partyId &&
        incoming().partyName == existing().partyName &&
        incoming().fromUid == existing().fromUid &&
        incoming().toUid == existing().toUid &&
        incoming().fromGameUid == existing().fromGameUid &&
        incoming().toGameUid == existing().toGameUid &&
        incoming().fromName == existing().fromName &&
        incoming().toName == existing().toName &&
        incoming().fromIsGm == existing().fromIsGm &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(inviteId) &&
        (existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isEmailVerified() && isValidId(userId) && userId == request.auth.uid;
      allow list: if false;
      allow create: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
