rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidGameUid(gameUid) {
      return gameUid is string && gameUid.size() >= 4 && gameUid.size() <= 8 && gameUid.matches('^[0-9]{4,8}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isGmAccount() {
      return isSignedIn() &&
        isEmailVerified() &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == 'ffsmilepay53@gmail.com';
    }

    function isUserAccountOwner(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'gameUid', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'gameUid', 'role', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == request.auth.uid &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 320 &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 100 &&
        isValidGameUid(data.gameUid) &&
        data.role in ['gm', 'player'] &&
        (
          (isGmAccount() && data.gameUid == '0000' && data.role == 'gm') ||
          (!isGmAccount() && data.gameUid != '0000' && data.role == 'player')
        ) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPlayerUidEntry(data, gameUid) {
      return data.keys().hasAll([
          'gameUid',
          'ownerId',
          'displayName',
          'characterName',
          'level',
          'jobId',
          'isGm',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'gameUid',
          'ownerId',
          'displayName',
          'characterName',
          'level',
          'jobId',
          'isGm',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidGameUid(data.gameUid) &&
        data.gameUid == gameUid &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 100 &&
        data.characterName is string &&
        data.characterName.size() >= 1 &&
        data.characterName.size() <= 24 &&
        data.level is int &&
        data.level >= 1 &&
        data.level <= 999 &&
        data.jobId is string &&
        data.jobId.size() >= 1 &&
        data.jobId.size() <= 32 &&
        data.jobId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.isGm is bool &&
        (
          (gameUid == '0000' && isGmAccount() && data.isGm == true) ||
          (gameUid != '0000' && data.isGm == false)
        ) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFriendRequest(data, requestId) {
      return data.keys().hasAll([
          'requestId',
          'fromUid',
          'toUid',
          'fromGameUid',
          'toGameUid',
          'fromName',
          'toName',
          'fromIsGm',
          'toIsGm',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'requestId',
          'fromUid',
          'toUid',
          'fromGameUid',
          'toGameUid',
          'fromName',
          'toName',
          'fromIsGm',
          'toIsGm',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.requestId) &&
        data.requestId == requestId &&
        isValidId(data.fromUid) &&
        isValidId(data.toUid) &&
        data.fromUid != data.toUid &&
        data.requestId == data.fromUid + '__' + data.toUid &&
        isValidGameUid(data.fromGameUid) &&
        isValidGameUid(data.toGameUid) &&
        data.fromGameUid != data.toGameUid &&
        data.fromName is string &&
        data.fromName.size() >= 1 &&
        data.fromName.size() <= 100 &&
        data.toName is string &&
        data.toName.size() >= 1 &&
        data.toName.size() <= 100 &&
        data.fromIsGm is bool &&
        data.toIsGm is bool &&
        data.status in ['pending', 'accepted', 'declined'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCharacterSave(data, characterId) {
      return data.keys().hasAll([
          'id',
          'ownerId',
          'name',
          'jobId',
          'level',
          'exp',
          'hp',
          'mp',
          'gold',
          'diamonds',
          'mapId',
          'playTime',
          'saveData',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'ownerId',
          'name',
          'jobId',
          'level',
          'exp',
          'hp',
          'mp',
          'gold',
          'diamonds',
          'mapId',
          'playTime',
          'saveData',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == characterId &&
        data.id.size() <= 64 &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 24 &&
        data.jobId is string &&
        data.jobId.size() >= 1 &&
        data.jobId.size() <= 32 &&
        data.jobId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.level is int &&
        data.level >= 1 &&
        data.level <= 999 &&
        data.exp is int &&
        data.exp >= 0 &&
        data.hp is int &&
        data.hp >= 0 &&
        data.mp is int &&
        data.mp >= 0 &&
        data.gold is int &&
        data.gold >= 0 &&
        data.diamonds is int &&
        data.diamonds >= 0 &&
        data.mapId is string &&
        data.mapId.size() >= 1 &&
        data.mapId.size() <= 32 &&
        data.mapId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.playTime is number &&
        data.playTime >= 0 &&
        data.saveData is map &&
        data.saveData.keys().size() <= 60 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMissionEntry(m) {
      return m is map &&
        m.keys().hasAll([
          'id',
          'type',
          'title',
          'description',
          'target',
          'progress',
          'claimed',
          'rewardGold',
          'rewardDiamonds',
          'rewardExp',
          'rewardStones'
        ]) &&
        m.keys().hasOnly([
          'id',
          'type',
          'title',
          'description',
          'target',
          'progress',
          'claimed',
          'rewardGold',
          'rewardDiamonds',
          'rewardExp',
          'rewardStones'
        ]) &&
        isValidId(m.id) &&
        m.id.size() <= 64 &&
        m.type in ['kills', 'bossKills', 'skillsUsed', 'enhances', 'towerClears', 'goldEarned', 'itemsLooted'] &&
        m.title is string &&
        m.title.size() >= 1 &&
        m.title.size() <= 80 &&
        m.description is string &&
        m.description.size() >= 1 &&
        m.description.size() <= 200 &&
        m.target is int &&
        m.target >= 1 &&
        m.target <= 100000 &&
        m.progress is int &&
        m.progress >= 0 &&
        m.progress <= 100000 &&
        m.claimed is bool &&
        m.rewardGold is int &&
        m.rewardGold >= 0 &&
        m.rewardGold <= 100000 &&
        m.rewardDiamonds is int &&
        m.rewardDiamonds >= 0 &&
        m.rewardDiamonds <= 10000 &&
        m.rewardExp is int &&
        m.rewardExp >= 0 &&
        m.rewardExp <= 100000 &&
        m.rewardStones is int &&
        m.rewardStones >= 0 &&
        m.rewardStones <= 1000;
    }

    function isValidMissionTransition(prev, next) {
      return prev.id == next.id &&
        prev.type == next.type &&
        prev.target == next.target &&
        prev.rewardGold == next.rewardGold &&
        prev.rewardDiamonds == next.rewardDiamonds &&
        prev.rewardExp == next.rewardExp &&
        prev.rewardStones == next.rewardStones &&
        next.progress >= prev.progress &&
        (!prev.claimed || next.claimed) &&
        (!next.claimed || next.progress >= next.target);
    }

    function isValidDailyMissionBoard(data, dateKey) {
      return data.keys().hasAll(['dateKey', 'ownerId', 'missions', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['dateKey', 'ownerId', 'missions', 'createdAt', 'updatedAt']) &&
        data.dateKey is string &&
        data.dateKey == dateKey &&
        data.dateKey.size() == 10 &&
        data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.ownerId is string &&
        data.ownerId == request.auth.uid &&
        data.missions is list &&
        data.missions.size() == 3 &&
        isValidMissionEntry(data.missions[0]) &&
        isValidMissionEntry(data.missions[1]) &&
        isValidMissionEntry(data.missions[2]) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWorldPresence(data, userId) {
      return data.keys().hasAll([
          'userId',
          'gameUid',
          'uid',
          'displayName',
          'jobId',
          'mapId',
          'x',
          'y',
          'level',
          'gm',
          'facing',
          'moving',
          'status',
          'attackAnim',
          'invisible',
          'heartbeatMs',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'gameUid',
          'uid',
          'displayName',
          'jobId',
          'mapId',
          'x',
          'y',
          'level',
          'gm',
          'facing',
          'moving',
          'status',
          'attackAnim',
          'invisible',
          'heartbeatMs',
          'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userId == userId &&
        data.userId == request.auth.uid &&
        isValidGameUid(data.gameUid) &&
        data.uid is int &&
        data.uid >= 0 &&
        data.uid <= 99999999 &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 24 &&
        data.jobId is string &&
        data.jobId.size() >= 1 &&
        data.jobId.size() <= 32 &&
        data.jobId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.mapId is string &&
        data.mapId.size() >= 1 &&
        data.mapId.size() <= 32 &&
        data.mapId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.x is number &&
        data.x >= 0 &&
        data.x <= 5000 &&
        data.y is number &&
        data.y >= 0 &&
        data.y <= 5000 &&
        data.level is int &&
        data.level >= 1 &&
        data.level <= 999 &&
        data.gm is bool &&
        (
          (data.gm == true && isGmAccount() && data.uid == 0 && data.gameUid == '0000') ||
          (data.gm == false && data.uid > 0 && data.gameUid != '0000')
        ) &&
        data.facing in ['up', 'down', 'left', 'right'] &&
        data.moving is bool &&
        data.status is string &&
        data.status in ['town', 'idle', 'moving', 'combat'] &&
        data.attackAnim is number &&
        data.attackAnim >= 0 &&
        data.attackAnim <= 5 &&
        data.invisible is bool &&
        data.invisible == false &&
        data.heartbeatMs is int &&
        data.heartbeatMs >= 0 &&
        data.updatedAt is timestamp;
    }

    function isValidPartyMemberInfo(member, memberUid) {
      return member is map &&
        member.keys().hasAll(['userId', 'uid', 'gameUid', 'name', 'jobId', 'level', 'hp', 'maxHp', 'mapId', 'isGm']) &&
        member.keys().hasOnly(['userId', 'uid', 'gameUid', 'name', 'jobId', 'level', 'hp', 'maxHp', 'mapId', 'isGm']) &&
        isValidId(member.userId) &&
        member.userId == memberUid &&
        member.uid is int &&
        member.uid >= 0 &&
        member.uid <= 99999999 &&
        isValidGameUid(member.gameUid) &&
        member.name is string &&
        member.name.size() >= 1 &&
        member.name.size() <= 24 &&
        member.jobId is string &&
        member.jobId.size() >= 1 &&
        member.jobId.size() <= 32 &&
        member.jobId.matches('^[a-zA-Z0-9_\\-]+$') &&
        member.level is int &&
        member.level >= 1 &&
        member.level <= 999 &&
        member.hp is int &&
        member.hp >= 0 &&
        member.hp <= 100000000 &&
        member.maxHp is int &&
        member.maxHp >= 1 &&
        member.maxHp <= 100000000 &&
        member.mapId is string &&
        member.mapId.size() >= 1 &&
        member.mapId.size() <= 32 &&
        member.mapId.matches('^[a-zA-Z0-9_\\-]+$') &&
        member.isGm is bool &&
        (
          (member.isGm == true && member.uid == 0 && member.gameUid == '0000') ||
          (member.isGm == false && member.uid > 0 && member.gameUid != '0000')
        );
    }

    function isValidPartyDoc(data, partyId) {
      return data.keys().hasAll(['partyId', 'name', 'leaderId', 'memberIds', 'members', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['partyId', 'name', 'leaderId', 'memberIds', 'members', 'createdAt', 'updatedAt']) &&
        isValidId(data.partyId) &&
        data.partyId == partyId &&
        data.partyId.size() >= 4 &&
        data.partyId.size() <= 64 &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 32 &&
        isValidId(data.leaderId) &&
        data.memberIds is list &&
        data.memberIds.size() >= 1 &&
        data.memberIds.size() <= 4 &&
        data.memberIds[0] is string &&
        data.leaderId in data.memberIds &&
        data.members is map &&
        data.members.keys().hasAll(data.memberIds) &&
        data.members.keys().hasOnly(data.memberIds) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPartyInvite(data, inviteId) {
      return data.keys().hasAll([
          'inviteId',
          'partyId',
          'partyName',
          'fromUid',
          'toUid',
          'fromGameUid',
          'toGameUid',
          'fromName',
          'toName',
          'fromIsGm',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'inviteId',
          'partyId',
          'partyName',
          'fromUid',
          'toUid',
          'fromGameUid',
          'toGameUid',
          'fromName',
          'toName',
          'fromIsGm',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.inviteId) &&
        data.inviteId == inviteId &&
        isValidId(data.partyId) &&
        data.partyId.size() >= 4 &&
        data.partyId.size() <= 64 &&
        data.partyName is string &&
        data.partyName.size() >= 1 &&
        data.partyName.size() <= 32 &&
        isValidId(data.fromUid) &&
        isValidId(data.toUid) &&
        data.fromUid != data.toUid &&
        data.inviteId == data.partyId + '__' + data.toUid &&
        isValidGameUid(data.fromGameUid) &&
        isValidGameUid(data.toGameUid) &&
        data.fromGameUid != data.toGameUid &&
        data.fromName is string &&
        data.fromName.size() >= 1 &&
        data.fromName.size() <= 24 &&
        data.toName is string &&
        data.toName.size() >= 1 &&
        data.toName.size() <= 24 &&
        data.fromIsGm is bool &&
        data.status in ['pending', 'accepted', 'declined'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGuildDoc(data, guildId) {
      return data.keys().hasAll([
          'guildId',
          'name',
          'tag',
          'leaderId',
          'leaderName',
          'level',
          'exp',
          'totalDonatedGold',
          'memberIds',
          'memberCount',
          'notice',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'guildId',
          'name',
          'tag',
          'leaderId',
          'leaderName',
          'level',
          'exp',
          'totalDonatedGold',
          'memberIds',
          'memberCount',
          'notice',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.guildId) &&
        data.guildId == guildId &&
        data.name is string &&
        data.name.size() >= 2 &&
        data.name.size() <= 28 &&
        data.tag is string &&
        data.tag.size() >= 2 &&
        data.tag.size() <= 6 &&
        isValidId(data.leaderId) &&
        data.leaderName is string &&
        data.leaderName.size() >= 1 &&
        data.leaderName.size() <= 24 &&
        data.level is int &&
        data.level >= 1 &&
        data.level <= 50 &&
        data.exp is int &&
        data.exp >= 0 &&
        data.totalDonatedGold is int &&
        data.totalDonatedGold >= 0 &&
        data.memberIds is list &&
        data.memberIds.size() >= 1 &&
        data.memberIds.size() <= 30 &&
        data.memberCount is int &&
        data.memberCount == data.memberIds.size() &&
        data.notice is string &&
        data.notice.size() <= 140 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLeaderboardHero(data, userId) {
      return data.keys().hasAll([
          'userId',
          'gameUid',
          'name',
          'jobId',
          'level',
          'rebirthCount',
          'combatPower',
          'arenaRating',
          'arenaWins',
          'highestTowerFloor',
          'activeTitle',
          'guildName',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'gameUid',
          'name',
          'jobId',
          'level',
          'rebirthCount',
          'combatPower',
          'arenaRating',
          'arenaWins',
          'highestTowerFloor',
          'activeTitle',
          'guildName',
          'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userId == userId &&
        isValidGameUid(data.gameUid) &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 24 &&
        data.jobId is string &&
        data.jobId.size() >= 1 &&
        data.jobId.size() <= 32 &&
        data.jobId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.level is int &&
        data.level >= 1 &&
        data.level <= 999 &&
        data.rebirthCount is int &&
        data.rebirthCount >= 0 &&
        data.rebirthCount <= 6 &&
        data.combatPower is int &&
        data.combatPower >= 1 &&
        data.arenaRating is int &&
        data.arenaRating >= 100 &&
        data.arenaRating <= 9999 &&
        data.arenaWins is int &&
        data.arenaWins >= 0 &&
        data.highestTowerFloor is int &&
        data.highestTowerFloor >= 0 &&
        (data.activeTitle == null || (data.activeTitle is string && data.activeTitle.size() <= 64)) &&
        (data.guildName == null || (data.guildName is string && data.guildName.size() <= 32)) &&
        data.updatedAt is timestamp;
    }

    function isValidWorldBossRaid(data, cycleKey) {
      return data.keys().hasAll([
          'cycleKey',
          'bossId',
          'name',
          'maxHp',
          'currentHp',
          'totalDamageDealt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'cycleKey',
          'bossId',
          'name',
          'maxHp',
          'currentHp',
          'totalDamageDealt',
          'updatedAt'
        ]) &&
        isValidId(data.cycleKey) &&
        data.cycleKey == cycleKey &&
        isValidId(data.bossId) &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 64 &&
        data.maxHp is int &&
        data.maxHp >= 1000 &&
        data.currentHp is int &&
        data.currentHp >= 0 &&
        data.currentHp <= data.maxHp &&
        data.totalDamageDealt is int &&
        data.totalDamageDealt >= 0 &&
        data.updatedAt is timestamp;
    }

    function isValidWorldBossContribution(data, userId) {
      return data.keys().hasAll(['userId', 'name', 'jobId', 'level', 'damage', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'name', 'jobId', 'level', 'damage', 'updatedAt']) &&
        isValidId(data.userId) &&
        data.userId == userId &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 24 &&
        data.jobId is string &&
        data.jobId.size() >= 1 &&
        data.jobId.size() <= 32 &&
        data.jobId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.level is int &&
        data.level >= 1 &&
        data.level <= 999 &&
        data.damage is int &&
        data.damage >= 0 &&
        data.updatedAt is timestamp;
    }

    function isValidGuildMessage(data, messageId) {
      return data.keys().hasAll(['messageId', 'senderUid', 'senderName', 'senderGameUid', 'jobId', 'text', 'createdAtMs', 'createdAt']) &&
        data.keys().hasOnly(['messageId', 'senderUid', 'senderName', 'senderGameUid', 'jobId', 'text', 'createdAtMs', 'createdAt']) &&
        isValidId(data.messageId) &&
        data.messageId == messageId &&
        isValidId(data.senderUid) &&
        data.senderName is string &&
        data.senderName.size() >= 1 &&
        data.senderName.size() <= 24 &&
        isValidGameUid(data.senderGameUid) &&
        data.jobId is string &&
        data.jobId.size() >= 1 &&
        data.jobId.size() <= 32 &&
        data.jobId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.text is string &&
        data.text.size() >= 1 &&
        data.text.size() <= 180 &&
        data.createdAtMs is int &&
        data.createdAtMs >= 0 &&
        data.createdAt is timestamp;
    }

    function isValidGuildRaid(data, guildId, raidId) {
      return data.keys().hasAll(['raidId', 'guildId', 'bossName', 'level', 'maxHp', 'currentHp', 'clears', 'lastHitter', 'updatedAt']) &&
        data.keys().hasOnly(['raidId', 'guildId', 'bossName', 'level', 'maxHp', 'currentHp', 'clears', 'lastHitter', 'updatedAt']) &&
        isValidId(data.raidId) &&
        data.raidId == raidId &&
        isValidId(data.guildId) &&
        data.guildId == guildId &&
        data.bossName is string &&
        data.bossName.size() >= 1 &&
        data.bossName.size() <= 64 &&
        data.level is int &&
        data.level >= 1 &&
        data.level <= 999 &&
        data.maxHp is int &&
        data.maxHp >= 1000 &&
        data.currentHp is int &&
        data.currentHp >= 0 &&
        data.currentHp <= data.maxHp &&
        data.clears is int &&
        data.clears >= 0 &&
        data.lastHitter is string &&
        data.lastHitter.size() <= 24 &&
        data.updatedAt is timestamp;
    }

    function isValidMarketListing(data, listingId) {
      return data.keys().hasAll([
          'listingId',
          'sellerUid',
          'sellerName',
          'sellerGameUid',
          'itemId',
          'itemName',
          'kind',
          'qty',
          'plus',
          'priceGold',
          'status',
          'buyerUid',
          'buyerName',
          'createdAtMs',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'listingId',
          'sellerUid',
          'sellerName',
          'sellerGameUid',
          'itemId',
          'itemName',
          'kind',
          'qty',
          'plus',
          'priceGold',
          'status',
          'buyerUid',
          'buyerName',
          'createdAtMs',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.listingId) &&
        data.listingId == listingId &&
        isValidId(data.sellerUid) &&
        data.sellerName is string &&
        data.sellerName.size() >= 1 &&
        data.sellerName.size() <= 24 &&
        isValidGameUid(data.sellerGameUid) &&
        isValidId(data.itemId) &&
        data.itemName is string &&
        data.itemName.size() >= 1 &&
        data.itemName.size() <= 64 &&
        data.kind is string &&
        data.kind.size() >= 1 &&
        data.kind.size() <= 24 &&
        data.qty is int &&
        data.qty >= 1 &&
        data.qty <= 999 &&
        data.plus is int &&
        data.plus >= 0 &&
        data.plus <= 20 &&
        data.priceGold is int &&
        data.priceGold >= 1 &&
        data.priceGold <= 100000000 &&
        data.status in ['open', 'sold', 'cancelled'] &&
        (data.buyerUid == null || isValidId(data.buyerUid)) &&
        (data.buyerName == null || (data.buyerName is string && data.buyerName.size() >= 1 && data.buyerName.size() <= 24)) &&
        data.createdAtMs is int &&
        data.createdAtMs >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMailMessage(data, mailId) {
      return data.keys().hasAll([
          'mailId',
          'senderUid',
          'senderName',
          'senderGameUid',
          'subject',
          'body',
          'gold',
          'diamonds',
          'itemId',
          'qty',
          'plus',
          'claimed',
          'createdAtMs',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'mailId',
          'senderUid',
          'senderName',
          'senderGameUid',
          'subject',
          'body',
          'gold',
          'diamonds',
          'itemId',
          'qty',
          'plus',
          'claimed',
          'createdAtMs',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.mailId) &&
        data.mailId == mailId &&
        isValidId(data.senderUid) &&
        data.senderName is string &&
        data.senderName.size() >= 1 &&
        data.senderName.size() <= 24 &&
        isValidGameUid(data.senderGameUid) &&
        data.subject is string &&
        data.subject.size() >= 1 &&
        data.subject.size() <= 64 &&
        data.body is string &&
        data.body.size() >= 1 &&
        data.body.size() <= 240 &&
        data.gold is int &&
        data.gold >= 0 &&
        data.gold <= 10000000 &&
        data.diamonds is int &&
        data.diamonds >= 0 &&
        data.diamonds <= 100000 &&
        (data.itemId == null || isValidId(data.itemId)) &&
        data.qty is int &&
        data.qty >= 0 &&
        data.qty <= 999 &&
        data.plus is int &&
        data.plus >= 0 &&
        data.plus <= 20 &&
        data.claimed is bool &&
        data.createdAtMs is int &&
        data.createdAtMs >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPartyCoop(data, partyId, coopId) {
      return data.keys().hasAll(['coopId', 'partyId', 'dungeonName', 'bossName', 'level', 'maxHp', 'currentHp', 'clears', 'participants', 'lastHitter', 'updatedAt']) &&
        data.keys().hasOnly(['coopId', 'partyId', 'dungeonName', 'bossName', 'level', 'maxHp', 'currentHp', 'clears', 'participants', 'lastHitter', 'updatedAt']) &&
        isValidId(data.coopId) &&
        data.coopId == coopId &&
        isValidId(data.partyId) &&
        data.partyId == partyId &&
        data.dungeonName is string &&
        data.dungeonName.size() >= 1 &&
        data.dungeonName.size() <= 64 &&
        data.bossName is string &&
        data.bossName.size() >= 1 &&
        data.bossName.size() <= 64 &&
        data.level is int &&
        data.level >= 1 &&
        data.level <= 999 &&
        data.maxHp is int &&
        data.maxHp >= 1000 &&
        data.currentHp is int &&
        data.currentHp >= 0 &&
        data.currentHp <= data.maxHp &&
        data.clears is int &&
        data.clears >= 0 &&
        data.participants is list &&
        data.participants.size() <= 8 &&
        data.lastHitter is string &&
        data.lastHitter.size() <= 24 &&
        data.updatedAt is timestamp;
    }

    match /playerUids/{gameUid} {
      allow get: if isSignedIn() && isEmailVerified() && isValidGameUid(gameUid);
      allow list: if false;
      allow create: if isSignedIn() &&
        isEmailVerified() &&
        isValidGameUid(gameUid) &&
        isValidPlayerUidEntry(incoming(), gameUid) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isUserAccountOwner(request.auth.uid);
      allow update: if isSignedIn() &&
        isEmailVerified() &&
        isValidGameUid(gameUid) &&
        isValidPlayerUidEntry(incoming(), gameUid) &&
        existing().ownerId == request.auth.uid &&
        incoming().gameUid == existing().gameUid &&
        incoming().ownerId == existing().ownerId &&
        incoming().isGm == existing().isGm &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'characterName', 'level', 'jobId', 'updatedAt']) &&
        isUserAccountOwner(request.auth.uid);
      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      allow get: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(requestId) &&
        (resource == null || existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);
      allow list: if isSignedIn() &&
        isEmailVerified() &&
        (existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);
      allow create: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(requestId) &&
        isValidFriendRequest(incoming(), requestId) &&
        incoming().fromUid == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().fromIsGm == (incoming().fromGameUid == '0000' && isGmAccount()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/playerUids/$(incoming().fromGameUid)) &&
        get(/databases/$(database)/documents/playerUids/$(incoming().fromGameUid)).data.ownerId == request.auth.uid &&
        exists(/databases/$(database)/documents/playerUids/$(incoming().toGameUid)) &&
        get(/databases/$(database)/documents/playerUids/$(incoming().toGameUid)).data.ownerId == incoming().toUid &&
        get(/databases/$(database)/documents/playerUids/$(incoming().toGameUid)).data.isGm == incoming().toIsGm;
      allow update: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(requestId) &&
        isValidFriendRequest(incoming(), requestId) &&
        existing().toUid == request.auth.uid &&
        existing().status == 'pending' &&
        (incoming().status == 'accepted' || incoming().status == 'declined') &&
        incoming().requestId == existing().requestId &&
        incoming().fromUid == existing().fromUid &&
        incoming().toUid == existing().toUid &&
        incoming().fromGameUid == existing().fromGameUid &&
        incoming().toGameUid == existing().toGameUid &&
        incoming().fromName == existing().fromName &&
        incoming().toName == existing().toName &&
        incoming().fromIsGm == existing().fromIsGm &&
        incoming().toIsGm == existing().toIsGm &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(requestId) &&
        (existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);
    }

    match /worldPresence/{userId} {
      allow get: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(userId) &&
        (resource == null || existing().userId == request.auth.uid || existing().invisible == false);

      allow list: if isSignedIn() &&
        isEmailVerified() &&
        resource.data.mapId is string &&
        request.query.limit != null &&
        request.query.limit <= 60;

      allow create: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isUserAccountOwner(userId) &&
        isValidWorldPresence(incoming(), userId) &&
        incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isUserAccountOwner(userId) &&
        isValidWorldPresence(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'gameUid',
          'uid',
          'displayName',
          'jobId',
          'mapId',
          'x',
          'y',
          'level',
          'gm',
          'facing',
          'moving',
          'status',
          'attackAnim',
          'invisible',
          'heartbeatMs',
          'updatedAt'
        ]);

      allow delete: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(userId) &&
        userId == request.auth.uid;
    }

    match /parties/{partyId} {
      allow get: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(partyId) &&
        (resource == null || request.auth.uid in existing().memberIds);

      allow list: if isSignedIn() &&
        isEmailVerified() &&
        request.auth.uid in resource.data.memberIds &&
        request.query.limit != null &&
        request.query.limit <= 10;

      allow create: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(partyId) &&
        isValidPartyDoc(incoming(), partyId) &&
        incoming().leaderId == request.auth.uid &&
        incoming().memberIds.size() == 1 &&
        incoming().memberIds[0] == request.auth.uid &&
        isValidPartyMemberInfo(incoming().members[request.auth.uid], request.auth.uid) &&
        (incoming().members[request.auth.uid].isGm == false || isGmAccount()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isUserAccountOwner(request.auth.uid);

      allow update: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(partyId) &&
        isValidPartyDoc(incoming(), partyId) &&
        incoming().partyId == existing().partyId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Member updates own live RPG snapshot (hp/level/mapId/jobId/name)
          (
            request.auth.uid in existing().memberIds &&
            incoming().name == existing().name &&
            incoming().leaderId == existing().leaderId &&
            incoming().memberIds == existing().memberIds &&
            incoming().diff(existing()).affectedKeys().hasOnly(['members', 'updatedAt']) &&
            incoming().members.diff(existing().members).affectedKeys().hasOnly([request.auth.uid]) &&
            isValidPartyMemberInfo(incoming().members[request.auth.uid], request.auth.uid) &&
            (incoming().members[request.auth.uid].isGm == false || isGmAccount())
          ) ||
          // Action 2: Invited player joins party with a verified pending invite
          (
            !(request.auth.uid in existing().memberIds) &&
            existing().memberIds.size() < 4 &&
            incoming().name == existing().name &&
            incoming().leaderId == existing().leaderId &&
            incoming().memberIds.size() == existing().memberIds.size() + 1 &&
            incoming().memberIds.hasAll(existing().memberIds) &&
            request.auth.uid in incoming().memberIds &&
            incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'members', 'updatedAt']) &&
            incoming().members.diff(existing().members).affectedKeys().hasOnly([request.auth.uid]) &&
            isValidPartyMemberInfo(incoming().members[request.auth.uid], request.auth.uid) &&
            (incoming().members[request.auth.uid].isGm == false || isGmAccount()) &&
            exists(/databases/$(database)/documents/partyInvites/$(partyId + '__' + request.auth.uid)) &&
            get(/databases/$(database)/documents/partyInvites/$(partyId + '__' + request.auth.uid)).data.status == 'pending' &&
            get(/databases/$(database)/documents/partyInvites/$(partyId + '__' + request.auth.uid)).data.toUid == request.auth.uid &&
            get(/databases/$(database)/documents/partyInvites/$(partyId + '__' + request.auth.uid)).data.partyId == partyId
          ) ||
          // Action 3: Member voluntarily leaves party (transfers leader if leader leaves with members remaining)
          (
            request.auth.uid in existing().memberIds &&
            !(request.auth.uid in incoming().memberIds) &&
            incoming().name == existing().name &&
            incoming().memberIds.size() == existing().memberIds.size() - 1 &&
            incoming().memberIds.size() >= 1 &&
            existing().memberIds.hasAll(incoming().memberIds) &&
            (existing().leaderId == request.auth.uid || incoming().leaderId == existing().leaderId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['leaderId', 'memberIds', 'members', 'updatedAt']) &&
            incoming().members.diff(existing().members).affectedKeys().hasOnly([request.auth.uid])
          ) ||
          // Action 4: Leader renames party, transfers leadership, or kicks another member
          (
            existing().leaderId == request.auth.uid &&
            request.auth.uid in incoming().memberIds &&
            existing().memberIds.hasAll(incoming().memberIds) &&
            incoming().memberIds.size() >= 1 &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'leaderId', 'memberIds', 'members', 'updatedAt']) &&
            existing().members.keys().hasAll(incoming().members.keys())
          )
        );

      allow delete: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(partyId) &&
        (
          existing().leaderId == request.auth.uid ||
          (existing().memberIds.size() == 1 && request.auth.uid in existing().memberIds)
        );

      match /coops/{coopId} {
        allow get: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(partyId) &&
          isValidId(coopId) &&
          exists(/databases/$(database)/documents/parties/$(partyId)) &&
          request.auth.uid in get(/databases/$(database)/documents/parties/$(partyId)).data.memberIds;

        allow list: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(partyId) &&
          exists(/databases/$(database)/documents/parties/$(partyId)) &&
          request.auth.uid in get(/databases/$(database)/documents/parties/$(partyId)).data.memberIds &&
          request.query.limit != null &&
          request.query.limit <= 5;

        allow create: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(partyId) &&
          isValidId(coopId) &&
          exists(/databases/$(database)/documents/parties/$(partyId)) &&
          request.auth.uid in get(/databases/$(database)/documents/parties/$(partyId)).data.memberIds &&
          isValidPartyCoop(incoming(), partyId, coopId) &&
          incoming().updatedAt == request.time;

        allow update: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(partyId) &&
          isValidId(coopId) &&
          exists(/databases/$(database)/documents/parties/$(partyId)) &&
          request.auth.uid in get(/databases/$(database)/documents/parties/$(partyId)).data.memberIds &&
          isValidPartyCoop(incoming(), partyId, coopId) &&
          incoming().coopId == existing().coopId &&
          incoming().partyId == existing().partyId &&
          incoming().clears >= existing().clears &&
          incoming().updatedAt == request.time;

        allow delete: if false;
      }
    }

    match /partyInvites/{inviteId} {
      allow get: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(inviteId) &&
        (resource == null || existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);

      allow list: if isSignedIn() &&
        isEmailVerified() &&
        (existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid) &&
