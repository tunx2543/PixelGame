          ) ||
          (
            (existing().challengerUid == request.auth.uid || existing().opponentUid == request.auth.uid) &&
            incoming().status == 'cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if false;
    }

    match /shopSettings/{settingId} {
      allow get: if isSignedIn() &&
        isEmailVerified() &&
        settingId == 'promptpay';

      allow list: if false;

      allow create: if isTopupAdminAccount() &&
        settingId == 'promptpay' &&
        isValidPromptPayShopSettings(incoming(), settingId) &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isTopupAdminAccount() &&
        settingId == 'promptpay' &&
        isValidPromptPayShopSettings(incoming(), settingId) &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().createdAtMs == existing().createdAtMs &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'promptPayId',
          'accountName',
          'customQrDataUrl',
          'enabled',
          'updatedByUid',
          'updatedAtMs',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    match /topupSlipRequests/{requestId} {
      allow get: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(requestId) &&
        (
          isTopupAdminAccount() ||
          (resource != null && existing().ownerId == request.auth.uid)
        );

      allow list: if isSignedIn() &&
        isEmailVerified() &&
        (existing().ownerId == request.auth.uid || isTopupAdminAccount()) &&
        request.query.limit != null &&
        request.query.limit <= 50;

      allow create: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(requestId) &&
        isValidTopupSlipRequest(incoming(), requestId) &&
        incoming().ownerId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().claimed == false &&
        incoming().claimedAtMs == null &&
        incoming().reviewedByUid == null &&
        incoming().reviewNote == null &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(requestId) &&
        isValidTopupSlipRequest(incoming(), requestId) &&
        incoming().requestId == existing().requestId &&
        incoming().ownerId == existing().ownerId &&
        incoming().ownerEmail == existing().ownerEmail &&
        incoming().characterId == existing().characterId &&
        incoming().packageId == existing().packageId &&
        incoming().amountThb == existing().amountThb &&
        incoming().baseDiamonds == existing().baseDiamonds &&
        incoming().bonusDiamonds == existing().bonusDiamonds &&
        incoming().totalDiamonds == existing().totalDiamonds &&
        incoming().vipExpGranted == existing().vipExpGranted &&
        incoming().slipDataUrl == existing().slipDataUrl &&
        incoming().createdAtMs == existing().createdAtMs &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isTopupAdminAccount() &&
            existing().status == 'pending' &&
            (incoming().status == 'approved' || incoming().status == 'rejected') &&
            incoming().reviewedByUid == request.auth.uid &&
            incoming().claimed == false &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'reviewedByUid',
              'reviewNote',
              'updatedAt'
            ])
          ) ||
          (
            existing().ownerId == request.auth.uid &&
            existing().status == 'approved' &&
            existing().claimed == false &&
            incoming().claimed == true &&
            incoming().status == 'approved' &&
            incoming().claimedAtMs is int &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'claimed',
              'claimedAtMs',
              'updatedAt'
            ])
          )
        );

      allow delete: if false;
    }

    match /playerReports/{reportId} {
      allow get: if isGmAccount() ||
        (
          isSignedIn() &&
          isEmailVerified() &&
          isValidId(reportId) &&
          resource != null &&
          existing().reporterUid == request.auth.uid
        );

      allow list: if isGmAccount() &&
        request.query.limit != null &&
        request.query.limit <= 50;

      allow create: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(reportId) &&
        isValidPlayerReport(incoming(), reportId) &&
        incoming().reporterUid == request.auth.uid &&
        incoming().targetUid != request.auth.uid &&
        incoming().createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
