rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidGameUid(gameUid) {
      return gameUid is string && gameUid.size() >= 4 && gameUid.size() <= 8 && gameUid.matches('^[0-9]{4,8}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isGmAccount() {
      return isSignedIn() &&
        isEmailVerified() &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == 'ffsmilepay53@gmail.com';
    }

    function isUserAccountOwner(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'gameUid', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'gameUid', 'role', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == request.auth.uid &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 320 &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 100 &&
        isValidGameUid(data.gameUid) &&
        data.role in ['gm', 'player'] &&
        (
          (isGmAccount() && data.gameUid == '0000' && data.role == 'gm') ||
          (!isGmAccount() && data.gameUid != '0000' && data.role == 'player')
        ) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPlayerUidEntry(data, gameUid) {
      return data.keys().hasAll([
          'gameUid',
          'ownerId',
          'displayName',
          'characterName',
          'level',
          'jobId',
          'isGm',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'gameUid',
          'ownerId',
          'displayName',
          'characterName',
          'level',
          'jobId',
          'isGm',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidGameUid(data.gameUid) &&
        data.gameUid == gameUid &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 100 &&
        data.characterName is string &&
        data.characterName.size() >= 1 &&
        data.characterName.size() <= 24 &&
        data.level is int &&
        data.level >= 1 &&
        data.level <= 999 &&
        data.jobId is string &&
        data.jobId.size() >= 1 &&
        data.jobId.size() <= 32 &&
        data.jobId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.isGm is bool &&
        (
          (gameUid == '0000' && isGmAccount() && data.isGm == true) ||
          (gameUid != '0000' && data.isGm == false)
        ) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFriendRequest(data, requestId) {
      return data.keys().hasAll([
          'requestId',
          'fromUid',
          'toUid',
          'fromGameUid',
          'toGameUid',
          'fromName',
          'toName',
          'fromIsGm',
          'toIsGm',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'requestId',
          'fromUid',
          'toUid',
          'fromGameUid',
          'toGameUid',
          'fromName',
          'toName',
          'fromIsGm',
          'toIsGm',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.requestId) &&
        data.requestId == requestId &&
        isValidId(data.fromUid) &&
        isValidId(data.toUid) &&
        data.fromUid != data.toUid &&
        data.requestId == data.fromUid + '__' + data.toUid &&
        isValidGameUid(data.fromGameUid) &&
        isValidGameUid(data.toGameUid) &&
        data.fromGameUid != data.toGameUid &&
        data.fromName is string &&
        data.fromName.size() >= 1 &&
        data.fromName.size() <= 100 &&
        data.toName is string &&
        data.toName.size() >= 1 &&
        data.toName.size() <= 100 &&
        data.fromIsGm is bool &&
        data.toIsGm is bool &&
        data.status in ['pending', 'accepted', 'declined'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCharacterSave(data, characterId) {
      return data.keys().hasAll([
          'id',
          'ownerId',
          'name',
          'jobId',
          'level',
          'exp',
          'hp',
          'mp',
          'gold',
          'diamonds',
          'mapId',
          'playTime',
          'saveData',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'ownerId',
          'name',
          'jobId',
          'level',
          'exp',
          'hp',
          'mp',
          'gold',
          'diamonds',
          'mapId',
          'playTime',
          'saveData',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == characterId &&
        data.id.size() <= 64 &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 24 &&
        data.jobId is string &&
        data.jobId.size() >= 1 &&
        data.jobId.size() <= 32 &&
        data.jobId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.level is int &&
        data.level >= 1 &&
        data.level <= 999 &&
        data.exp is int &&
        data.exp >= 0 &&
        data.hp is int &&
        data.hp >= 0 &&
        data.mp is int &&
        data.mp >= 0 &&
        data.gold is int &&
        data.gold >= 0 &&
        data.diamonds is int &&
        data.diamonds >= 0 &&
        data.mapId is string &&
        data.mapId.size() >= 1 &&
        data.mapId.size() <= 32 &&
        data.mapId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.playTime is number &&
        data.playTime >= 0 &&
        data.saveData is map &&
        data.saveData.keys().size() <= 60 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMissionEntry(m) {
      return m is map &&
        m.keys().hasAll([
          'id',
          'type',
          'title',
          'description',
          'target',
          'progress',
          'claimed',
          'rewardGold',
          'rewardDiamonds',
          'rewardExp',
          'rewardStones'
        ]) &&
        m.keys().hasOnly([
          'id',
          'type',
          'title',
          'description',
          'target',
          'progress',
          'claimed',
          'rewardGold',
          'rewardDiamonds',
          'rewardExp',
          'rewardStones'
        ]) &&
        isValidId(m.id) &&
        m.id.size() <= 64 &&
        m.type in ['kills', 'bossKills', 'skillsUsed', 'enhances', 'towerClears', 'goldEarned', 'itemsLooted'] &&
        m.title is string &&
        m.title.size() >= 1 &&
        m.title.size() <= 80 &&
        m.description is string &&
        m.description.size() >= 1 &&
        m.description.size() <= 200 &&
        m.target is int &&
        m.target >= 1 &&
        m.target <= 100000 &&
        m.progress is int &&
        m.progress >= 0 &&
        m.progress <= 100000 &&
        m.claimed is bool &&
        m.rewardGold is int &&
        m.rewardGold >= 0 &&
        m.rewardGold <= 100000 &&
        m.rewardDiamonds is int &&
        m.rewardDiamonds >= 0 &&
        m.rewardDiamonds <= 10000 &&
        m.rewardExp is int &&
        m.rewardExp >= 0 &&
        m.rewardExp <= 100000 &&
        m.rewardStones is int &&
        m.rewardStones >= 0 &&
        m.rewardStones <= 1000;
    }

    function isValidMissionTransition(prev, next) {
      return prev.id == next.id &&
        prev.type == next.type &&
        prev.target == next.target &&
        prev.rewardGold == next.rewardGold &&
        prev.rewardDiamonds == next.rewardDiamonds &&
        prev.rewardExp == next.rewardExp &&
        prev.rewardStones == next.rewardStones &&
        next.progress >= prev.progress &&
        (!prev.claimed || next.claimed) &&
        (!next.claimed || next.progress >= next.target);
    }

    function isValidDailyMissionBoard(data, dateKey) {
      return data.keys().hasAll(['dateKey', 'ownerId', 'missions', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['dateKey', 'ownerId', 'missions', 'createdAt', 'updatedAt']) &&
        data.dateKey is string &&
        data.dateKey == dateKey &&
        data.dateKey.size() == 10 &&
        data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.ownerId is string &&
        data.ownerId == request.auth.uid &&
        data.missions is list &&
        data.missions.size() == 3 &&
        isValidMissionEntry(data.missions[0]) &&
        isValidMissionEntry(data.missions[1]) &&
        isValidMissionEntry(data.missions[2]) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /playerUids/{gameUid} {
      allow get: if isSignedIn() && isEmailVerified() && isValidGameUid(gameUid);
      allow list: if false;
      allow create: if isSignedIn() &&
        isEmailVerified() &&
        isValidGameUid(gameUid) &&
        isValidPlayerUidEntry(incoming(), gameUid) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isUserAccountOwner(request.auth.uid);
      allow update: if isSignedIn() &&
        isEmailVerified() &&
        isValidGameUid(gameUid) &&
        isValidPlayerUidEntry(incoming(), gameUid) &&
        existing().ownerId == request.auth.uid &&
        incoming().gameUid == existing().gameUid &&
        incoming().ownerId == existing().ownerId &&
        incoming().isGm == existing().isGm &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'characterName', 'level', 'jobId', 'updatedAt']) &&
        isUserAccountOwner(request.auth.uid);
      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      allow get: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(requestId) &&
        (resource == null || existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);
      allow list: if isSignedIn() &&
        isEmailVerified() &&
        (existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);
      allow create: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(requestId) &&
        isValidFriendRequest(incoming(), requestId) &&
        incoming().fromUid == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().fromIsGm == (incoming().fromGameUid == '0000' && isGmAccount()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/playerUids/$(incoming().fromGameUid)) &&
        get(/databases/$(database)/documents/playerUids/$(incoming().fromGameUid)).data.ownerId == request.auth.uid &&
        exists(/databases/$(database)/documents/playerUids/$(incoming().toGameUid)) &&
        get(/databases/$(database)/documents/playerUids/$(incoming().toGameUid)).data.ownerId == incoming().toUid &&
        get(/databases/$(database)/documents/playerUids/$(incoming().toGameUid)).data.isGm == incoming().toIsGm;
      allow update: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(requestId) &&
        isValidFriendRequest(incoming(), requestId) &&
        existing().toUid == request.auth.uid &&
        existing().status == 'pending' &&
        (incoming().status == 'accepted' || incoming().status == 'declined') &&
        incoming().requestId == existing().requestId &&
        incoming().fromUid == existing().fromUid &&
        incoming().toUid == existing().toUid &&
        incoming().fromGameUid == existing().fromGameUid &&
        incoming().toGameUid == existing().toGameUid &&
        incoming().fromName == existing().fromName &&
        incoming().toName == existing().toName &&
        incoming().fromIsGm == existing().fromIsGm &&
        incoming().toIsGm == existing().toIsGm &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(requestId) &&
        (existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isEmailVerified() && isValidId(userId) && userId == request.auth.uid;
      allow list: if false;
      allow create: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isGmAccount() ||
          (
            (!('gameUid' in existing()) || incoming().gameUid == existing().gameUid) &&
            (!('role' in existing()) || existing().role == 'player')
          )
        ) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'gameUid', 'role', 'updatedAt']);
      allow delete: if false;

      match /characters/{characterId} {
        allow get: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(userId) &&
          isValidId(characterId) &&
          userId == request.auth.uid &&
          isUserAccountOwner(userId) &&
          (resource == null || existing().ownerId == request.auth.uid);

        allow list: if isSignedIn() &&
          isEmailVerified() &&
          userId == request.auth.uid &&
          existing().ownerId == request.auth.uid;

        allow create: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(userId) &&
          isValidId(characterId) &&
          userId == request.auth.uid &&
          isValidCharacterSave(incoming(), characterId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isUserAccountOwner(userId);

        allow update: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(userId) &&
          isValidId(characterId) &&
          userId == request.auth.uid &&
          isValidCharacterSave(incoming(), characterId) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'jobId',
            'level',
            'exp',
            'hp',
            'mp',
            'gold',
            'diamonds',
            'mapId',
            'playTime',
            'saveData',
            'updatedAt'
          ]) &&
          isUserAccountOwner(userId);

        allow delete: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(userId) &&
          isValidId(characterId) &&
          userId == request.auth.uid &&
          isUserAccountOwner(userId) &&
          existing().ownerId == request.auth.uid;
      }

      match /dailyMissions/{dateKey} {
        allow get: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(userId) &&
          userId == request.auth.uid &&
          dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
          (resource == null || !('ownerId' in existing()) || existing().ownerId == request.auth.uid);

        allow list: if isSignedIn() &&
          isEmailVerified() &&
          userId == request.auth.uid &&
          existing().ownerId == request.auth.uid;

        allow create: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(userId) &&
          userId == request.auth.uid &&
          dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
          isValidDailyMissionBoard(incoming(), dateKey) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;

        allow update: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(userId) &&
          userId == request.auth.uid &&
          dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
          isValidDailyMissionBoard(incoming(), dateKey) &&
          (
            (
              isValidDailyMissionBoard(existing(), dateKey) &&
              incoming().dateKey == existing().dateKey &&
              incoming().ownerId == existing().ownerId &&
              incoming().createdAt == existing().createdAt &&
              incoming().updatedAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly(['missions', 'updatedAt']) &&
              isValidMissionTransition(existing().missions[0], incoming().missions[0]) &&
              isValidMissionTransition(existing().missions[1], incoming().missions[1]) &&
              isValidMissionTransition(existing().missions[2], incoming().missions[2])
            ) ||
            (
              !isValidDailyMissionBoard(existing(), dateKey) &&
              (!('ownerId' in existing()) || existing().ownerId == request.auth.uid) &&
              incoming().createdAt == request.time &&
              incoming().updatedAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly(['dateKey', 'ownerId', 'missions', 'createdAt', 'updatedAt'])
            )
          );

        allow delete: if isGmAccount() &&
          isValidId(userId) &&
          userId == request.auth.uid &&
          dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
          existing().ownerId == request.auth.uid;
      }
    }
  }
}
