      match /characters/{characterId} {
        allow get: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(userId) &&
          isValidId(characterId) &&
          userId == request.auth.uid &&
          isUserAccountOwner(userId) &&
          (resource == null || existing().ownerId == request.auth.uid);

        allow list: if isSignedIn() &&
          isEmailVerified() &&
          userId == request.auth.uid &&
          existing().ownerId == request.auth.uid;

        allow create: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(userId) &&
          isValidId(characterId) &&
          userId == request.auth.uid &&
          isValidCharacterSave(incoming(), characterId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isUserAccountOwner(userId);

        allow update: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(userId) &&
          isValidId(characterId) &&
          userId == request.auth.uid &&
          isValidCharacterSave(incoming(), characterId) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'jobId',
            'level',
            'exp',
            'hp',
            'mp',
            'gold',
            'diamonds',
            'mapId',
            'playTime',
            'saveData',
            'updatedAt'
          ]) &&
          isUserAccountOwner(userId);

        allow delete: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(userId) &&
          isValidId(characterId) &&
          userId == request.auth.uid &&
          isUserAccountOwner(userId) &&
          existing().ownerId == request.auth.uid;
      }

      match /dailyMissions/{dateKey} {
        allow get: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(userId) &&
          userId == request.auth.uid &&
          dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
          (resource == null || !('ownerId' in existing()) || existing().ownerId == request.auth.uid);

        allow list: if isSignedIn() &&
          isEmailVerified() &&
          userId == request.auth.uid &&
          existing().ownerId == request.auth.uid;

        allow create: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(userId) &&
          userId == request.auth.uid &&
          dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
          isValidDailyMissionBoard(incoming(), dateKey) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;

        allow update: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(userId) &&
          userId == request.auth.uid &&
          dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
          isValidDailyMissionBoard(incoming(), dateKey) &&
          (
            (
              isValidDailyMissionBoard(existing(), dateKey) &&
              incoming().dateKey == existing().dateKey &&
              incoming().ownerId == existing().ownerId &&
              incoming().createdAt == existing().createdAt &&
              incoming().updatedAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly(['missions', 'updatedAt']) &&
              isValidMissionTransition(existing().missions[0], incoming().missions[0]) &&
              isValidMissionTransition(existing().missions[1], incoming().missions[1]) &&
              isValidMissionTransition(existing().missions[2], incoming().missions[2])
            ) ||
            (
              !isValidDailyMissionBoard(existing(), dateKey) &&
              (!('ownerId' in existing()) || existing().ownerId == request.auth.uid) &&
              incoming().createdAt == request.time &&
              incoming().updatedAt == request.time
            )
          );

        allow delete: if isGmAccount() &&
          isValidId(userId) &&
          userId == request.auth.uid &&
          dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
          existing().ownerId == request.auth.uid;
      }

      match /mailbox/{mailId} {
        allow get: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(userId) &&
          isValidId(mailId) &&
          userId == request.auth.uid;

        allow list: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(userId) &&
          userId == request.auth.uid &&
          request.query.limit != null &&
          request.query.limit <= 40;

        allow create: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(userId) &&
          isValidId(mailId) &&
          isValidMailMessage(incoming(), mailId) &&
          incoming().claimed == false &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isUserAccountOwner(request.auth.uid) &&
          (
            userId == request.auth.uid ||
            (
              incoming().senderUid == request.auth.uid &&
              exists(/databases/$(database)/documents/users/$(userId))
            )
          );

        allow update: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(userId) &&
          isValidId(mailId) &&
          userId == request.auth.uid &&
          isValidMailMessage(incoming(), mailId) &&
          !existing().claimed &&
          incoming().claimed == true &&
          incoming().mailId == existing().mailId &&
          incoming().senderUid == existing().senderUid &&
          incoming().gold == existing().gold &&
          incoming().diamonds == existing().diamonds &&
          incoming().itemId == existing().itemId &&
          incoming().qty == existing().qty &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['claimed', 'updatedAt']);

        allow delete: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(userId) &&
          isValidId(mailId) &&
          userId == request.auth.uid;
      }
    }

    match /guilds/{guildId} {
      allow get: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(guildId);

      allow list: if isSignedIn() &&
        isEmailVerified() &&
        resource.data.memberCount >= 1 &&
        request.query.limit != null &&
        request.query.limit <= 30;

      allow create: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(guildId) &&
        isValidGuildDoc(incoming(), guildId) &&
        incoming().leaderId == request.auth.uid &&
        incoming().memberIds.size() == 1 &&
        incoming().memberIds[0] == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isUserAccountOwner(request.auth.uid);

      allow update: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(guildId) &&
        isValidGuildDoc(incoming(), guildId) &&
        incoming().guildId == existing().guildId &&
        incoming().name == existing().name &&
        incoming().tag == existing().tag &&
        incoming().leaderId == existing().leaderId &&
        incoming().leaderName == existing().leaderName &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isUserAccountOwner(request.auth.uid) &&
        (
          (
            request.auth.uid == existing().leaderId &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'level',
              'exp',
              'totalDonatedGold',
              'memberIds',
              'memberCount',
              'notice',
              'updatedAt'
            ])
          ) ||
          (
            request.auth.uid in existing().memberIds &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'level',
              'exp',
              'totalDonatedGold',
              'memberIds',
              'memberCount',
              'updatedAt'
            ])
          ) ||
          (
            !(request.auth.uid in existing().memberIds) &&
            request.auth.uid in incoming().memberIds &&
            incoming().memberCount == existing().memberCount + 1 &&
            incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'memberCount', 'updatedAt'])
          )
        );

      allow delete: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(guildId) &&
        existing().leaderId == request.auth.uid &&
        existing().memberCount <= 1;

      match /messages/{messageId} {
        allow get: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(guildId) &&
          isValidId(messageId) &&
          exists(/databases/$(database)/documents/guilds/$(guildId)) &&
          request.auth.uid in get(/databases/$(database)/documents/guilds/$(guildId)).data.memberIds;

        allow list: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(guildId) &&
          exists(/databases/$(database)/documents/guilds/$(guildId)) &&
          request.auth.uid in get(/databases/$(database)/documents/guilds/$(guildId)).data.memberIds &&
          request.query.limit != null &&
          request.query.limit <= 50;

        allow create: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(guildId) &&
          isValidId(messageId) &&
          exists(/databases/$(database)/documents/guilds/$(guildId)) &&
          request.auth.uid in get(/databases/$(database)/documents/guilds/$(guildId)).data.memberIds &&
          isValidGuildMessage(incoming(), messageId) &&
          incoming().senderUid == request.auth.uid &&
          incoming().createdAt == request.time;

        allow update, delete: if false;
      }

      match /raids/{raidId} {
        allow get: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(guildId) &&
          isValidId(raidId) &&
          exists(/databases/$(database)/documents/guilds/$(guildId)) &&
          request.auth.uid in get(/databases/$(database)/documents/guilds/$(guildId)).data.memberIds;

        allow list: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(guildId) &&
          exists(/databases/$(database)/documents/guilds/$(guildId)) &&
          request.auth.uid in get(/databases/$(database)/documents/guilds/$(guildId)).data.memberIds &&
          request.query.limit != null &&
          request.query.limit <= 5;

        allow create: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(guildId) &&
          isValidId(raidId) &&
          exists(/databases/$(database)/documents/guilds/$(guildId)) &&
          request.auth.uid in get(/databases/$(database)/documents/guilds/$(guildId)).data.memberIds &&
          isValidGuildRaid(incoming(), guildId, raidId) &&
          incoming().updatedAt == request.time;

        allow update: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(guildId) &&
          isValidId(raidId) &&
          exists(/databases/$(database)/documents/guilds/$(guildId)) &&
          request.auth.uid in get(/databases/$(database)/documents/guilds/$(guildId)).data.memberIds &&
          isValidGuildRaid(incoming(), guildId, raidId) &&
          incoming().raidId == existing().raidId &&
          incoming().guildId == existing().guildId &&
          incoming().clears >= existing().clears &&
          incoming().updatedAt == request.time;

        allow delete: if false;
      }
    }

    match /leaderboard/{userId} {
      allow get: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(userId);

      allow list: if isSignedIn() &&
        isEmailVerified() &&
        resource.data.combatPower >= 1 &&
        request.query.limit != null &&
        request.query.limit <= 50;

      allow create: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidLeaderboardHero(incoming(), userId) &&
        incoming().updatedAt == request.time &&
        isUserAccountOwner(userId);

      allow update: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidLeaderboardHero(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'gameUid',
          'name',
          'jobId',
          'level',
          'rebirthCount',
          'combatPower',
          'arenaRating',
          'arenaWins',
          'highestTowerFloor',
          'activeTitle',
          'guildName',
          'updatedAt'
        ]) &&
        isUserAccountOwner(userId);

      allow delete: if false;
    }

    match /worldBoss/{cycleKey} {
      allow get: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(cycleKey);

      allow list: if isSignedIn() &&
        isEmailVerified() &&
        resource.data.maxHp >= 1000 &&
        request.query.limit != null &&
        request.query.limit <= 10;

      allow create: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(cycleKey) &&
        isValidWorldBossRaid(incoming(), cycleKey) &&
        incoming().updatedAt == request.time &&
        isUserAccountOwner(request.auth.uid);

      allow update: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(cycleKey) &&
        isValidWorldBossRaid(incoming(), cycleKey) &&
        incoming().cycleKey == existing().cycleKey &&
        incoming().bossId == existing().bossId &&
        incoming().name == existing().name &&
        incoming().maxHp == existing().maxHp &&
        incoming().currentHp <= existing().currentHp &&
        incoming().totalDamageDealt >= existing().totalDamageDealt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['currentHp', 'totalDamageDealt', 'updatedAt']) &&
        isUserAccountOwner(request.auth.uid);

      allow delete: if false;

      match /contributions/{userId} {
        allow get: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(cycleKey) &&
          isValidId(userId);

        allow list: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(cycleKey) &&
          resource.data.damage >= 0 &&
          request.query.limit != null &&
          request.query.limit <= 30;

        allow create: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(cycleKey) &&
          isValidId(userId) &&
          userId == request.auth.uid &&
          isValidWorldBossContribution(incoming(), userId) &&
          incoming().updatedAt == request.time &&
          isUserAccountOwner(userId);

        allow update: if isSignedIn() &&
          isEmailVerified() &&
          isValidId(cycleKey) &&
          isValidId(userId) &&
          userId == request.auth.uid &&
          isValidWorldBossContribution(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().damage >= existing().damage &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'jobId', 'level', 'damage', 'updatedAt']) &&
          isUserAccountOwner(userId);

        allow delete: if false;
      }
    }

    match /marketListings/{listingId} {
      allow get: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(listingId);

      allow list: if isSignedIn() &&
        isEmailVerified() &&
        resource.data.status == 'open' &&
        request.query.limit != null &&
        request.query.limit <= 50;

      allow create: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(listingId) &&
        isValidMarketListing(incoming(), listingId) &&
        incoming().sellerUid == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().buyerUid == null &&
        incoming().buyerName == null &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isUserAccountOwner(request.auth.uid);

      allow update: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(listingId) &&
        isValidMarketListing(incoming(), listingId) &&
        existing().status == 'open' &&
        incoming().listingId == existing().listingId &&
        incoming().sellerUid == existing().sellerUid &&
        incoming().sellerName == existing().sellerName &&
        incoming().sellerGameUid == existing().sellerGameUid &&
        incoming().itemId == existing().itemId &&
        incoming().itemName == existing().itemName &&
        incoming().kind == existing().kind &&
        incoming().qty == existing().qty &&
        incoming().plus == existing().plus &&
        incoming().priceGold == existing().priceGold &&
        incoming().createdAtMs == existing().createdAtMs &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'buyerUid', 'buyerName', 'updatedAt']) &&
        (
          (
            request.auth.uid == existing().sellerUid &&
            incoming().status == 'cancelled' &&
            incoming().buyerUid == null &&
            incoming().buyerName == null
          ) ||
          (
            request.auth.uid != existing().sellerUid &&
            incoming().status == 'sold' &&
            incoming().buyerUid == request.auth.uid &&
            incoming().buyerName is string &&
            incoming().buyerName.size() >= 1 &&
            incoming().buyerName.size() <= 24
          )
        );

      allow delete: if isSignedIn() &&
        isEmailVerified() &&
        isValidId(listingId) &&
        existing().sellerUid == request.auth.uid &&
        existing().status != 'open';
    }
  }
}
